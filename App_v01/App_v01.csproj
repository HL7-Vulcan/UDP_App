<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RootNamespace>UDP_App</RootNamespace>
    <AssemblyName>UDP_App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Claude\**" />
    <Content Remove="Claude\**" />
    <EmbeddedResource Remove="Claude\**" />
    <None Remove="Claude\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- .fsh files are not recognised by the SDK so must be explicitly included -->
    <None Include="Templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- Static FSH project files for SUSHI (fsh-generated is created at runtime, not bundled) -->
    <None Include="SushiProject\**\*" Exclude="SushiProject\fsh-generated\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- .json sample files: Update sets publish flag on items SDK already knows -->
    <Content Update="Data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Startup script: installs Node.js + fsh-sushi on first run in the app container -->
    <None Include="startup.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="SushiProject\input\fsh\Examples\" />
  </ItemGroup>

</Project>
