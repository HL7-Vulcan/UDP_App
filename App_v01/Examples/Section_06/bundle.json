    {
      "resource": {
  "resourceType": "Composition",
  "id": "Narrative-Composition-M11Section06",
  "meta": {
    "profile": [
      "http://HL7Vulcan/UDP/IG/StructureDefinition/m11-research-study-narratives"
    ]
  },
  "author": [
    {
      "reference": "Narrative-Organization"
    }
  ],
  "section": [
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EThis section describes the investigational and noninvestigational trial interventions, including the rationale for dose selection, administration procedures, and concomitant therapy restrictions.\u003C/div\u003E"
      },
      "entry": [
        {
          "reference": "ActivityDefinition/InterventionTable-Row1"
        },
        {
          "reference": "ActivityDefinition/InterventionTable-Row2"
        },
        {
          "reference": "ActivityDefinition/InterventionTable-Row3"
        }
      ],
      "title": "Section 6",
      "code": {
        "coding": [
          {
            "code": "C218560",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6 TRIAL INTERVENTION AND CONCOMITANT THERAPY"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EExoticillin 500mg film-coated tablets. Nonproprietary name: exoticillin. Pharmaceutical dose form: film-coated tablet. Dosage strength: 500mg.\u003C/div\u003E"
      },
      "title": "Section 6.1",
      "code": {
        "coding": [
          {
            "code": "C218561",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.1 Description of Investigational Trial Intervention"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EThe dose of 500mg twice daily was selected based on Phase II data demonstrating optimal efficacy with an acceptable safety profile at this dose level.\u003C/div\u003E"
      },
      "title": "Section 6.2",
      "code": {
        "coding": [
          {
            "code": "C218562",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.2 Rationale for Investigational Trial Intervention Dose and Regimen"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EExoticillin 500mg tablets will be administered orally twice daily with or without food for the duration of the treatment period.\u003C/div\u003E"
      },
      "title": "Section 6.3",
      "code": {
        "coding": [
          {
            "code": "C218563",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.3 Investigational Trial Intervention Administration"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EDose reductions to 250mg twice daily are permitted for participants experiencing Grade 2 or higher adverse events attributable to the investigational product.\u003C/div\u003E"
      },
      "title": "Section 6.4",
      "code": {
        "coding": [
          {
            "code": "C218564",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.4 Investigational Trial Intervention Dose Modification"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EIn the event of overdose, symptomatic and supportive treatment should be provided. There is no specific antidote for exoticillin.\u003C/div\u003E"
      },
      "title": "Section 6.5",
      "code": {
        "coding": [
          {
            "code": "C218565",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.5 Management of Investigational Trial Intervention Overdose"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EInvestigational product will be supplied as blister packs by the sponsor. No preparation is required at site.\u003C/div\u003E"
      },
      "title": "Section 6.6.1",
      "code": {
        "coding": [
          {
            "code": "C218567",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.6.1 Preparation of Investigational Trial Intervention"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EInvestigational product must be stored at room temperature (15-25\u00B0C), protected from light and moisture.\u003C/div\u003E"
      },
      "title": "Section 6.6.2",
      "code": {
        "coding": [
          {
            "code": "C218568",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.6.2 Storage and Handling of Investigational Trial Intervention"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003ESite staff must maintain accurate records of all investigational product received, dispensed, and returned or destroyed.\u003C/div\u003E"
      },
      "title": "Section 6.6.3",
      "code": {
        "coding": [
          {
            "code": "C218569",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.6.3 Accountability of Investigational Trial Intervention"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EParticipants will be assigned to treatment using an Interactive Web Response System (IWRS).\u003C/div\u003E"
      },
      "title": "Section 6.7.1",
      "code": {
        "coding": [
          {
            "code": "C218571",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.7.1 Participant Assignment to Investigational Trial Intervention"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003ERandomisation will be performed centrally using a 1:1 ratio via the IWRS. Randomisation will be stratified by disease severity and geographic region.\u003C/div\u003E"
      },
      "title": "Section 6.7.2",
      "code": {
        "coding": [
          {
            "code": "C218572",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.7.2 Randomisation"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EThis is a double-blind trial. The investigational product and placebo are identical in appearance. The IWRS will maintain the blind.\u003C/div\u003E"
      },
      "title": "Section 6.7.3",
      "code": {
        "coding": [
          {
            "code": "C218573",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.7.3 Measures to Maintain Blinding"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EEmergency unblinding may be performed by the investigator in the event of a medical emergency. The sponsor must be notified within 24 hours.\u003C/div\u003E"
      },
      "title": "Section 6.7.4",
      "code": {
        "coding": [
          {
            "code": "C218574",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.7.4 Emergency Unblinding at the Site"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EAdherence will be assessed by tablet count at each visit. Participants with less than 80% adherence will be counselled by site staff.\u003C/div\u003E"
      },
      "title": "Section 6.8",
      "code": {
        "coding": [
          {
            "code": "C218575",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.8 Investigational Trial Intervention Adherence"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003ENo noninvestigational trial interventions are planned for this trial.\u003C/div\u003E"
      },
      "title": "Section 6.9",
      "code": {
        "coding": [
          {
            "code": "C218576",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.9 Description of Noninvestigational Trial Intervention"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EBackground therapy consists of standard-of-care treatment administered to all participants throughout the trial in addition to the investigational product.\u003C/div\u003E"
      },
      "title": "Section 6.9.1",
      "code": {
        "coding": [
          {
            "code": "C218577",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.9.1 Background Trial Intervention"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003ERescue therapy with short-acting bronchodilators is permitted for participants experiencing acute symptom exacerbation. Use of rescue therapy will be recorded in the eCRF.\u003C/div\u003E"
      },
      "title": "Section 6.9.2",
      "code": {
        "coding": [
          {
            "code": "C218578",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.9.2 Rescue Therapy"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003ENo other noninvestigational trial interventions are planned. Any additional medications required for participant safety will be recorded as concomitant medications.\u003C/div\u003E"
      },
      "title": "Section 6.9.3",
      "code": {
        "coding": [
          {
            "code": "C218579",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.9.3 Other Noninvestigational Trial Intervention"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EConcomitant medications taken within 30 days prior to screening and during the trial must be recorded in the electronic case report form.\u003C/div\u003E"
      },
      "title": "Section 6.10",
      "code": {
        "coding": [
          {
            "code": "C218580",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.10 Concomitant Therapy"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EThe following medications are prohibited during the trial: strong CYP3A4 inhibitors, strong CYP3A4 inducers, and other investigational products.\u003C/div\u003E"
      },
      "title": "Section 6.10.1",
      "code": {
        "coding": [
          {
            "code": "C218581",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.10.1 Prohibited Concomitant Therapy"
          }
        ]
      }
    },
    {
      "text": {
        "status": "additional",
        "div": "\u003Cdiv xmlns=\u0022http://www.w3.org/1999/xhtml\u0022 xml:lang=\u0022en\u0022 lang=\u0022en\u0022\u003EAll other concomitant medications are permitted provided they are stable for at least 30 days prior to randomisation.\u003C/div\u003E"
      },
      "title": "Section 6.10.2",
      "code": {
        "coding": [
          {
            "code": "C218582",
            "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl",
            "display": "ICH M11 Protocol Section 6.10.2 Permitted Concomitant Therapy"
          }
        ]
      }
    }
  ],
  "status": "final",
  "type": {
    "coding": [
      {
        "code": "C207508",
        "system": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl"
      }
