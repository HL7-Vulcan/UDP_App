    // ── Context menu ──────────────────────────────────────────────
    [JSInvokable]
    public async Task OnContextMenuJS(string code, double x, double y)
    {
        var info = GetFieldInfo(code);
        CtxFieldName    = code;
        CtxOriginalName = info.original;
        CtxGuidance     = info.guidance;
        StateHasChanged();
        await JS.InvokeVoidAsync("udpShowCtxMenu", "s12-ctx-menu", x, y);
    }

    [JSInvokable]
    public void OnCtxMenuClosed() { }

    private void CloseCtxMenu() =>
        _ = JS.InvokeVoidAsync("udpHideCtxMenu", "s12-ctx-menu");

    private (string original, string guidance) GetFieldInfo(string code)
    {
        // Strip row suffix for lookup
        var bare = System.Text.RegularExpressions.Regex.Replace(code, @"_[ar]\d+.*$", "");
        return bare switch
        {
            "C25294"  => ("ClinicalLaboratoryTests",          "Specify which clinical laboratory tests will be performed. Reference the Laboratory Manual for normal ranges."),
            "C218832" => ("CountryRegionIdentifier",          "Enter the country or region identifier, e.g. 'Japan', 'EU'."),
            "C218833" => ("CountryRegionRequirements",        "Describe any country or region-specific regulatory or procedural requirements."),
            "C218834" => ("CountryRegionClarifications",      "Describe any protocol clarifications specific to this country or region."),
            "C218477" => ("AmendmentIdentifier",              "Enter the amendment identifier, e.g. 'EX2010/12(a)'."),
            "C132352" => ("SponsorApprovalDate",              "Enter the date the sponsor approved this amendment."),
            "C218695" => ("ApproxEnrollment",                 "Enter the approximate number of participants enrolled when the sponsor approved the amendment."),
            "C218695e"=> ("EnrollmentScopeDescription",      "Select whether enrollment count applies globally or locally."),
            "C218836" => ("AlternateLocation",                "If the Overview of Changes is not provided in this section, specify where it can be found."),
            "C218483" => ("DescriptionOfChange",              "Describe the change made in this amendment."),
            "C181233" => ("RationaleForChange",               "Provide a brief rationale for why this change was made."),
            "C218479" => ("SectionAndName",                   "Select the section number and name where the change was made."),
            _         => (code,                               "Enter field value."),
        };
    }

    // ── Init ──────────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (_reinitCtxMenus)
            {
                _reinitCtxMenus = false;
                await JS.InvokeVoidAsync("udpInitContextMenus", "s12-ctx-menu");
            }
            return;
        }
        try
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("udpSetDotNetRef", _objRef);
            await JS.InvokeVoidAsync("udpInitContextMenus", "s12-ctx-menu");

            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "s12data");
            if (!string.IsNullOrEmpty(json))
            {
                var loaded = DataSvc.FromJson(json);
                if (loaded != null) { Model = loaded; StateHasChanged(); }
            }
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex) { ErrorMessage = "Init error: " + ex.Message; StateHasChanged(); }
    }

    // ── Status ────────────────────────────────────────────────────
    private void SetStatus(string msg)
    {
        StatusMessage = msg;
        _statusTimer?.Dispose();
        _statusTimer = new System.Threading.Timer(_ =>
        {
            StatusMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        }, null, 4000, System.Threading.Timeout.Infinite);
    }

    public void Dispose() { _objRef?.Dispose(); _statusTimer?.Dispose(); }
}
