    // ── Country/Region rows ───────────────────────────────────────
    private void AddCrRow()
    {
        Model.CrRows++;
        _reinitCtxMenus = true;
        AutoSave();
    }

    private void DeleteCrRow(int row)
    {
        // Shift rows down
        for (int r = row; r < Model.CrRows; r++)
        {
            foreach (var col in new[] { "C218832", "C218833", "C218834" })
            {
                var src = $"{col}_r{r + 1}";
                var dst = $"{col}_r{r}";
                Model.CrData[dst] = Model.CrData.TryGetValue(src, out var v) ? v : string.Empty;
            }
        }
        // Remove last
        foreach (var col in new[] { "C218832", "C218833", "C218834" })
            Model.CrData.Remove($"{col}_r{Model.CrRows}");
        Model.CrRows = Math.Max(0, Model.CrRows - 1);
        AutoSave();
    }

    // ── Amendment rows ────────────────────────────────────────────
    private void AddAmendRow()
    {
        Model.AmendRows++;
        var r = Model.AmendRows;
        Model.AmendData[$"C218695e_r{r}"] = string.Empty;
        _reinitCtxMenus = true;
        AutoSave();
    }

    private void DeleteAmendRow(int row)
    {
        // Shift amendment rows down
        for (int r = row; r < Model.AmendRows; r++)
        {
            var next = r + 1;
            foreach (var col in new[] { "C218477", "C132352", "C218695", "C218695e" })
            {
                var src = $"{col}_r{next}";
                var dst = $"{col}_r{r}";
                Model.AmendData[dst] = Model.AmendData.TryGetValue(src, out var v) ? v : string.Empty;
            }
            // Shift change data
            var chgCount = Model.ChgRows.TryGetValue(next.ToString(), out var c) ? c : 0;
            Model.ChgRows[r.ToString()] = chgCount;
            for (int cr = 1; cr <= chgCount; cr++)
            {
                foreach (var col in new[] { "C218483", "C181233", "C218479" })
                {
                    var src = $"{col}_a{next}_r{cr}";
                    var dst = $"{col}_a{r}_r{cr}";
                    Model.ChgData[dst] = Model.ChgData.TryGetValue(src, out var v) ? v : string.Empty;
                }
            }
        }
        // Remove last
        var last = Model.AmendRows;
        foreach (var col in new[] { "C218477", "C132352", "C218695", "C218695e" })
            Model.AmendData.Remove($"{col}_r{last}");
        var lastChg = Model.ChgRows.TryGetValue(last.ToString(), out var lc) ? lc : 0;
        for (int cr = 1; cr <= lastChg; cr++)
            foreach (var col in new[] { "C218483", "C181233", "C218479" })
                Model.ChgData.Remove($"{col}_a{last}_r{cr}");
        Model.ChgRows.Remove(last.ToString());

        Model.AmendRows = Math.Max(0, Model.AmendRows - 1);
        AutoSave();
    }

    // ── Change description rows ───────────────────────────────────
    private void AddChgRow(int amendIdx)
    {
        var key = amendIdx.ToString();
        var count = Model.ChgRows.TryGetValue(key, out var c) ? c : 0;
        count++;
        Model.ChgRows[key] = count;
        _reinitCtxMenus = true;
        AutoSave();
    }

    private void DeleteChgRow(int amendIdx, int row)
    {
        var key = amendIdx.ToString();
        var count = Model.ChgRows.TryGetValue(key, out var c) ? c : 0;
        for (int r = row; r < count; r++)
        {
            foreach (var col in new[] { "C218483", "C181233", "C218479" })
            {
                var src = $"{col}_a{amendIdx}_r{r + 1}";
                var dst = $"{col}_a{amendIdx}_r{r}";
                Model.ChgData[dst] = Model.ChgData.TryGetValue(src, out var v) ? v : string.Empty;
            }
        }
        foreach (var col in new[] { "C218483", "C181233", "C218479" })
            Model.ChgData.Remove($"{col}_a{amendIdx}_r{count}");
        Model.ChgRows[key] = Math.Max(0, count - 1);
        AutoSave();
    }

    // ── Amendment import ──────────────────────────────────────────
    private void OpenImportPicker()
    {
        ImportTargetRow = 1;
        ShowAmendPicker = true;
    }

    private void CloseImportPicker() => ShowAmendPicker = false;

    private void GoToAmendments()
    {
        ShowAmendPicker = false;
        Nav.NavigateTo("/amendments");
    }

    private void ApplyImport(AmendmentRecord rec)
    {
        var r = ImportTargetRow;
        if (r < 1 || r > Model.AmendRows) { ShowAmendPicker = false; return; }

        // Copy identifier, approval date (C93813 = Version Date in amendment), enrollment count
        Model.AmendData[$"C218477_r{r}"]  = rec.C218477  ?? string.Empty;
        Model.AmendData[$"C132352_r{r}"]  = rec.C93813   ?? string.Empty;
        Model.AmendData[$"C218695_r{r}"]  = rec.C218478  ?? string.Empty;  // approx enrolled
        Model.AmendData[$"C218695e_r{r}"] = rec.C218695  ?? string.Empty;  // enrollment scope

        // Copy change rows
        var chgCount = rec.ChgRows;
        Model.ChgRows[r.ToString()] = chgCount;
        for (int cr = 1; cr <= chgCount; cr++)
        {
            Model.ChgData[$"C218483_a{r}_r{cr}"] = rec.ChgData.TryGetValue($"C218483_r{cr}", out var desc)  ? desc  : string.Empty;
            Model.ChgData[$"C181233_a{r}_r{cr}"] = rec.ChgData.TryGetValue($"C181233_r{cr}", out var rat)   ? rat   : string.Empty;
            Model.ChgData[$"C218479_a{r}_r{cr}"] = rec.ChgData.TryGetValue($"C218479_r{cr}", out var sec)   ? sec   : string.Empty;
        }

        ShowAmendPicker = false;
        _reinitCtxMenus = true;
        AutoSave();
        SetStatus($"✓ Imported '{rec.Name}'");
    }

