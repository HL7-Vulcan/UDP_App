    private void LoadSample()
    {
        var first = Store.LoadSample();
        SelectRecord(first.Id);
        SetStatus("✓ Sample data loaded — 2 amendments created");
    }

    private void RenameAndSave(string? name)
    {
        if (Current == null) return;
        Current.Name = string.IsNullOrWhiteSpace(name) ? "Amendment" : name.Trim();
        Store.Update(Current);
    }

    // ── Field helpers ─────────────────────────────────────────────────

    private void SetAndSave(Action<string?> setter, string? value)
    {
        if (Current == null) return;
        setter(value);
        Store.Update(Current);
    }

    private void SetChgAndSave(string key, string? value)
    {
        if (Current == null) return;
        Current.ChgData[key] = value ?? string.Empty;
        Store.Update(Current);
    }

    // ── Change rows ───────────────────────────────────────────────────

    private void AddChgRow()
    {
        if (Current == null) return;
        var r = _nextChgRow++;
        _chgRows.Add(r);
        Current.ChgRows = _chgRows.Count;
        Store.Update(Current);
    }

    private void DeleteChgRow(int r)
    {
        if (Current == null) return;
        _chgRows.Remove(r);
        var keys = Current.ChgData.Keys.Where(k => k.EndsWith($"_r{r}")).ToList();
        foreach (var k in keys) Current.ChgData.Remove(k);
        Current.ChgRows = _chgRows.Count;
        Store.Update(Current);
    }

    // ── Status bar ────────────────────────────────────────────────────

    private void SetStatus(string msg)
    {
        _status = msg;
        _statusTimer?.Dispose();
        _statusTimer = new System.Threading.Timer(_ =>
        {
            _status = string.Empty;
            InvokeAsync(StateHasChanged);
        }, null, 3000, System.Threading.Timeout.Infinite);
    }

    public void Dispose() => _statusTimer?.Dispose();

