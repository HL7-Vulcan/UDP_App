    private void LoadSample()
    {
        var first = Store.LoadSample();
        SelectRecord(first.Id);
        SetStatus("✓ Sample data loaded — 2 amendments created");
    }

    private void RenameAndSave(string? name)
    {
        if (Current == null) return;
        Current.Name = string.IsNullOrWhiteSpace(name) ? "Amendment" : name.Trim();
        Store.Update(Current);
    }

    // ── Field helpers ─────────────────────────────────────────────────

    private void SetAndSave(Action<string?> setter, string? value)
    {
        if (Current == null) return;
        setter(value);
        Store.Update(Current);
    }

    private void SetChgAndSave(string key, string? value)
    {
        if (Current == null) return;
        Current.ChgData[key] = value ?? string.Empty;
        Store.Update(Current);
    }

    // ── Change rows ───────────────────────────────────────────────────

    private void AddChgRow()
    {
        if (Current == null) return;
        var r = _nextChgRow++;
        _chgRows.Add(r);
        Current.ChgRows = _chgRows.Count;
        Store.Update(Current);
    }

    private void DeleteChgRow(int r)
    {
        if (Current == null) return;
        _chgRows.Remove(r);
        var keys = Current.ChgData.Keys.Where(k => k.EndsWith($"_r{r}")).ToList();
        foreach (var k in keys) Current.ChgData.Remove(k);
        Current.ChgRows = _chgRows.Count;
        Store.Update(Current);
    }

    // ── Status bar ────────────────────────────────────────────────────

    private void SetStatus(string msg)
    {
        _status = msg;
        _statusTimer?.Dispose();
        _statusTimer = new System.Threading.Timer(_ =>
        {
            _status = string.Empty;
            InvokeAsync(StateHasChanged);
        }, null, 3000, System.Threading.Timeout.Infinite);
    }

    // ── Context menu ──────────────────────────────────────────────────

    [JSInvokable]
    public async Task OnContextMenuJS(string fieldId, double x, double y)
    {
        _ctxFieldName = fieldId;
        _ctxM11Name   = FieldTerms.For(fieldId);
        _ctxGuidance  = FieldGuidance.For(fieldId);
        var baseId       = System.Text.RegularExpressions.Regex.Replace(fieldId, @"_r\d+$", "");
        _ctxValueSetId    = FieldValueSets.TryGetValue(baseId, out var vsId) ? vsId : string.Empty;
        var vs            = string.IsNullOrEmpty(_ctxValueSetId) ? null : TermSvc.Get(_ctxValueSetId);
        _ctxValueSetCCode = vs?.CCode ?? string.Empty;
        _ctxValueSetName  = vs == null ? string.Empty : $"{vs.Name}  {vs.Id}";
        StateHasChanged();
        await JS.InvokeVoidAsync("udpShowCtxMenu", "ad-ctx-menu", x, y);
    }

    [JSInvokable] public void OnCtxMenuClosed() { }

    private void CloseCtxMenu() => _ = JS.InvokeVoidAsync("udpHideCtxMenu", "ad-ctx-menu");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _objRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("udpSetDotNetRef", _objRef, "ad-ctx-menu");
            }
            // Re-attach on every render: the form fields only appear after an amendment
            // is selected, so the first-render pass finds nothing to hook.
            await JS.InvokeVoidAsync("udpInitContextMenus", "ad-ctx-menu");
        }
        catch (JSDisconnectedException) { } catch (TaskCanceledException) { }
    }

    public void Dispose() { _objRef?.Dispose(); _statusTimer?.Dispose(); }

