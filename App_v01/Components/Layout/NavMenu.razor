<style>
    .nav-group-toggle {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        background: none;
        border: none;
        color: rgba(255,255,255,0.75);
        font-size: 0.9rem;
        padding: 0.35rem 0.5rem;
        cursor: pointer;
        text-align: left;
    }
    .nav-group-toggle:hover { color: #fff; background: rgba(255,255,255,0.08); border-radius: 4px; }
    .nav-group-toggle.open  { color: #fff; }
    .toggle-arrow { font-size: 0.7rem; transition: transform 0.15s; }
    .nav-group-toggle.open .toggle-arrow { transform: rotate(90deg); }
    .nav-group-items { padding-left: 0.5rem; }
    .nav-link.nav-sub { font-size: 0.85rem; padding-top: 0.2rem; padding-bottom: 0.2rem; }
</style>

