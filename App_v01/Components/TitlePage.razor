        </tr>
        <tr>
            <td class="lbl cond">Secondary Reason for Amendment:</td>
            <td><div class="type-badge">@(AmendFromStore ? "read-only" : "conditional multi-select")</div>
                <div data-ctx-wrap="C218697" style="position:relative">
                @ReasonMultiSelect("C218697", Model.C218697, v => { Model.C218697 = v; StateHasChanged(); }, AmendFromStore)
                </div>
                <div class="type-badge" style="margin-top:6px;">Other reason text (@(AmendFromStore ? "read-only" : "conditional string"))</div>
                <div data-ctx-wrap="C17649_2" style="position:relative">
                <input data-ctx="C17649_2" class="fb @(AmendFromStore ? "ro-inp" : "")" type="text" placeholder="Enter other reason"
                    disabled="@(AmendFromStore || !SecondaryOtherActive)"
                    style="@((!AmendFromStore && !SecondaryOtherActive) ? "opacity:0.4;cursor:not-allowed;" : "")"
                    @bind="Model.C17649_2" @bind:event="oninput" @bind:after="AutoSave" />
