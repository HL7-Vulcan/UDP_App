                @ReasonSelect("C218696", Model.C218696, v => Model.C218696 = v, AmendFromStore)
                </div>
                <div class="type-badge" style="margin-top:6px;">Other reason text (@(AmendFromStore ? "read-only" : "conditional string"))</div>
                <div data-ctx-wrap="C17649" style="position:relative">
                <input data-ctx="C17649" class="fb @(AmendFromStore ? "ro-inp" : "")" type="text" placeholder="Enter other reason"
                    disabled="@(AmendFromStore || !PrimaryOtherActive)"
