        </tr>
        <tr>
            <td class="lbl cond">Amendment Summary:</td>
            <td><div class="type-badge">@(AmendFromStore ? "read-only" : "conditional string")</div>
                <div data-ctx-wrap="C42581" style="position:relative">
                <textarea data-ctx="C42581" class="fb @(AmendFromStore ? "ro-ta" : "")" rows="3" placeholder="Briefly describe key changes"
                    @bind="Model.C42581" @bind:event="oninput" @bind:after="AutoSave" disabled="@AmendFromStore"></textarea>
                </div>
            </td>
        </tr>
        <tr>
            <td class="lbl cond">Substantial Impact on Safety or Rights?</td>
            <td>
                <div class="type-badge">@(AmendFromStore ? "read-only" : "conditional picklist")</div>
                <div data-ctx-wrap="C218698" style="position:relative">
                <PicklistSelect ValueSetId="m11-yes-no-vs" CssClass="@("fb-sel" + (AmendFromStore ? " ro-sel" : ""))"
                    DataCtx="C218698" @bind-Value="Model.C218698" @bind-Value:after="AutoSave" />
                </div>
                <div class="type-badge" style="margin-top:6px;">If yes, briefly explain (@(AmendFromStore ? "read-only" : "conditional string"))</div>
                <div data-ctx-wrap="C218699" style="position:relative">
                <textarea data-ctx="C218699" class="fb @(AmendFromStore ? "ro-ta" : "")" rows="2" placeholder="If yes, briefly explain"
                    @bind="Model.C218699" @bind:event="oninput" @bind:after="AutoSave" disabled="@AmendFromStore"></textarea>
                </div>
            </td>
        </tr>
        <tr>
            <td class="lbl cond">Substantial Impact on Reliability and Robustness?</td>
            <td>
                <div class="type-badge">@(AmendFromStore ? "read-only" : "conditional picklist")</div>
                <div data-ctx-wrap="C218700" style="position:relative">
                <PicklistSelect ValueSetId="m11-yes-no-vs" CssClass="@("fb-sel" + (AmendFromStore ? " ro-sel" : ""))"
                    DataCtx="C218700" @bind-Value="Model.C218700" @bind-Value:after="AutoSave" />
                </div>
                <div class="type-badge" style="margin-top:6px;">If yes, briefly explain (@(AmendFromStore ? "read-only" : "conditional string"))</div>
                <div data-ctx-wrap="C218701" style="position:relative">
                <textarea data-ctx="C218701" class="fb @(AmendFromStore ? "ro-ta" : "")" rows="2" placeholder="If yes, briefly explain"
                    @bind="Model.C218701" @bind:event="oninput" @bind:after="AutoSave" disabled="@AmendFromStore"></textarea>
                </div>
            </td>
        </tr>
    </table>

    <div class="h2">Overview of Changes in the Current Amendment</div>
    <table class="chg-tbl">
        <thead><tr>
            @if (!AmendFromStore) { <th style="width:5%"></th> }
            <th style="width:38%">Description of Change</th>
            <th style="width:32%">Brief Rationale for Change</th>
            <th style="width:25%">Section # and Name</th>
        </tr></thead>
        <tbody>
            @foreach (var row in ChgRows)
            {
                var r = row;
                <tr>
                    @if (!AmendFromStore)
                    {
                        <td style="text-align:center;vertical-align:middle;">
                            <button class="del-btn" @onclick="@(() => DeleteChgRow(r))">✕</button>
                        </td>
                    }
                    <td><div data-ctx-wrap="C218483" style="position:relative"><textarea data-ctx="C218483" class="fb @(AmendFromStore ? "ro-ta" : "")" rows="2" placeholder="Description of Change"
                        value="@GetChg($"C218483_r{r}")"
                        @oninput="@(e => SetChg($"C218483_r{r}", e.Value?.ToString()))" disabled="@AmendFromStore"></textarea></div></td>
                    <td><div data-ctx-wrap="C181233" style="position:relative"><textarea data-ctx="C181233" class="fb @(AmendFromStore ? "ro-ta" : "")" rows="2" placeholder="Brief Rationale for Change"
                        value="@GetChg($"C181233_r{r}")"
                        @oninput="@(e => SetChg($"C181233_r{r}", e.Value?.ToString()))" disabled="@AmendFromStore"></textarea></div></td>
                    <td>
                        <div data-ctx-wrap="C218479" style="position:relative">
                        <PicklistSelect ValueSetId="m11-protocol-section-vs" CssClass="@("fb-sel" + (AmendFromStore ? " ro-sel" : ""))"
