@page "/title-page"
@layout MainLayout
@using UDP_App.Models
@using UDP_App.Services
@inject DataServiceTP DataSvc
@inject SushiService SushiSvc
@inject FhirPipelineService PipelineSvc
@inject AmendmentStore AmendStore
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TerminologyService TermSvc
@implements IDisposable

<PageTitle>Title Page – Data Entry</PageTitle>

<style>
    .doc-page { background:#fff; width:794px; min-height:1123px; margin:30px auto 80px; padding:56px 72px; box-shadow:0 4px 24px rgba(0,0,0,0.18); font-family:'Calibri',Arial,sans-serif; font-size:11pt; color:#000; }
    .h1  { font-family:'Times New Roman',Times,serif; font-size:14pt; font-weight:700; margin:0 0 18px; }
    .h2  { font-family:'Times New Roman',Times,serif; font-size:12pt; font-weight:700; margin:22px 0 8px; border-bottom:1px solid #ccc; padding-bottom:3px; }
    .tp-tbl { width:100%; border-collapse:collapse; margin-bottom:12px; font-size:10.5pt; }
    .tp-tbl td { border:1px solid #bbb; padding:5px 8px; vertical-align:top; }
    .tp-tbl td.lbl { font-weight:700; white-space:nowrap; width:36%; background:#f0f4ff; color:#1f3864; font-size:10pt; }
    .tp-tbl td.req::after { content:" *"; color:#c00; font-size:9pt; }
    .tp-tbl td.cond { background:#f5f0ff; }
    textarea.fb { display:block; width:100%; background:#d0cece; color:#1a7a1a; border:none; border-bottom:1.5px solid #999; font-family:'Calibri',Arial,sans-serif; font-size:10.5pt; line-height:1.4; padding:3px 5px; outline:none; resize:vertical; min-height:36px; }
    textarea.fb:focus { background:#bfbcbc; }
    textarea.fb::placeholder { color:#9a7ab5; font-style:italic; }
    textarea.fb.req-empty { border-bottom:2px solid #c00; background:#f5d0d0; }
    input.fb { display:block; width:100%; background:#d0cece; color:#1a7a1a; border:none; border-bottom:1.5px solid #999; font-family:'Calibri',Arial,sans-serif; font-size:10.5pt; padding:3px 5px; outline:none; }
    input.fb:focus { background:#bfbcbc; }
    input.fb.req-empty { border-bottom:2px solid #c00; background:#f5d0d0; }
    select.fb-sel { display:block; width:100%; background:#d0cece; color:#1a7a1a; border:none; border-bottom:1.5px solid #999; font-family:'Calibri',Arial,sans-serif; font-size:10.5pt; padding:3px 5px; outline:none; cursor:pointer; }
    select.fb-sel:focus { background:#bfbcbc; }
    select.fb-sel.req-empty { border-bottom:2px solid #c00; background:#f5d0d0; }
    .type-badge { font-size:8pt; color:#888; font-style:italic; margin-bottom:3px; }
    /* Change overview table */
    .chg-tbl { width:100%; border-collapse:collapse; font-size:10pt; margin-top:8px; }
    .chg-tbl th { background:#1f3864; color:#fff; padding:5px 8px; text-align:left; font-size:9.5pt; }
    .chg-tbl td { border:1px solid #bbb; padding:3px 5px; vertical-align:top; }
    .chg-tbl textarea.fb { min-height:32px; }
    .add-btn { background:#00B050; color:#fff; border:none; border-radius:3px; padding:4px 12px; font-size:10pt; cursor:pointer; margin-top:6px; }
    .add-btn:hover { background:#008a3e; }
    .del-btn { background:none; border:none; color:#c00; font-size:14px; cursor:pointer; padding:0 3px; }
    .del-btn:hover { color:#900; }
    .toolbar { display:flex; justify-content:flex-end; gap:10px; margin-top:32px; flex-wrap:wrap; }
    .btn { padding:7px 20px; border:none; border-radius:3px; font-size:10pt; font-family:inherit; cursor:pointer; }
    .btn-primary   { background:#1f3864; color:#fff; } .btn-primary:hover { background:#162a4e; }
    .btn-secondary { background:#eee; color:#333; border:1px solid #ccc; } .btn-secondary:hover { background:#ddd; }
    .overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:200; align-items:center; justify-content:center; }
    .overlay.show { display:flex; }
    .dbox { background:#fff; border-radius:6px; padding:28px 32px; width:400px; box-shadow:0 8px 40px rgba(0,0,0,0.25); }
    .dbox h3 { font-size:13pt; font-weight:700; color:#1f3864; margin-bottom:12px; }
    .dbox p  { font-size:10.5pt; margin-bottom:16px; }
    .dbox input[type=text] { width:100%; border:1px solid #aaa; border-radius:3px; padding:6px 8px; font-size:10pt; margin-bottom:14px; outline:none; }
    .fmt-row { display:flex; gap:14px; margin-bottom:20px; }
    .fmt-row label { display:flex; align-items:center; gap:5px; font-size:10pt; cursor:pointer; }
    .dbr { display:flex; justify-content:flex-end; gap:10px; }
    .sbar { position:fixed; bottom:0; left:0; right:0; background:#1f3864; color:#fff; font-size:9pt; padding:5px 18px; display:flex; justify-content:space-between; align-items:center; z-index:100; }
    .err  { background:#fff3cd; color:#856404; border:1px solid #ffc107; padding:10px; margin-bottom:10px; border-radius:4px; font-size:10pt; }
    .ctx-menu { display:none; position:fixed; background:#fff; border:1px solid #ccc; border-radius:4px; box-shadow:0 4px 16px rgba(0,0,0,0.18); z-index:1000; min-width:320px; max-width:420px; font-family:'Calibri',Arial,sans-serif; font-size:10pt; }
    .ctx-hdr  { background:#1f3864; color:#fff; padding:8px 12px; font-weight:700; font-size:10pt; border-radius:4px 4px 0 0; display:flex; justify-content:space-between; align-items:center; }
    .ctx-close { background:none; border:none; color:#fff; font-size:14px; cursor:pointer; }
    .ctx-body { padding:10px 12px; }
    .ctx-row  { display:flex; gap:8px; margin-bottom:6px; font-size:9.5pt; }
    .ctx-row label { font-weight:700; white-space:nowrap; min-width:100px; color:#333; }
    .ctx-row span  { color:#555; word-break:break-all; }
    .ctx-div  { border:none; border-top:1px solid #e0e0e0; margin:8px 0; }
    .ctx-guide { font-size:9.5pt; color:#444; line-height:1.5; }
    /* Read-only from store — looks normal but not interactive */
    .ro-sel, .ro-inp, .ro-ta {
        opacity:1 !important; cursor:default !important;
        background:#f7f7f7 !important; color:#222 !important;
        pointer-events:none;
    }
    /* Amendment inactive overlay */
    .amend-inactive { position:relative; }
    .amend-inactive::after { content:""; position:absolute; inset:0; background:rgba(240,240,240,0.65); cursor:not-allowed; pointer-events:none; border-radius:2px; }
    .amend-inactive input, .amend-inactive select, .amend-inactive textarea, .amend-inactive button { pointer-events:none; opacity:0.5; }
    /* Amendment picker dialog */
    .ap-list { list-style:none; margin:0 0 16px; padding:0; max-height:220px; overflow-y:auto; border:1px solid #ddd; border-radius:4px; }
    .ap-list li { display:flex; align-items:center; justify-content:space-between; padding:8px 12px; border-bottom:1px solid #f0f0f0; font-size:10.5pt; }
    .ap-list li:last-child { border-bottom:none; }
    .ap-list li:hover { background:#f5f8ff; }
    .ap-item-name { flex:1; }
    .ap-item-meta { font-size:8.5pt; color:#888; margin-left:8px; }
    .ap-select-btn { background:#1f3864; color:#fff; border:none; border-radius:3px; padding:4px 12px; font-size:9.5pt; cursor:pointer; }
    .ap-select-btn:hover { background:#162a4e; }
    .ap-empty { color:#888; font-style:italic; font-size:10.5pt; text-align:center; padding:20px 0; }
    .ap-create-link { display:block; text-align:center; margin-top:8px; color:#1f3864; font-size:10pt; cursor:pointer; text-decoration:underline; }
</style>

@if (!string.IsNullOrEmpty(ErrorMessage)) { <div class="err">⚠ @ErrorMessage</div> }

<div class="doc-page">
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:10px;">
        <div class="h1" style="margin-bottom:0;">Title Page</div>
        <button class="add-btn" @onclick="GoToAmendments">Edit Amendments</button>
    </div>

    <table class="tp-tbl">
        <tr>
            <td class="lbl">Sponsor Confidentiality Statement:</td>
            <td><div class="type-badge">optional string</div>
                <textarea data-ctx="C181236" class="fb" rows="2" placeholder="Enter Sponsor Confidentiality Statement"
                    @bind="Model.C181236" @bind:event="oninput" @bind:after="AutoSave"></textarea></td>
        </tr>
        <tr>
            <td class="lbl req">Full Title</td>
            <td><div class="type-badge">required string</div>
                <textarea data-ctx="C132346" class="@ReqClass(Model.C132346)" rows="3" placeholder="Enter Full Title"
                    @bind="Model.C132346" @bind:event="oninput" @bind:after="AutoSave"></textarea></td>
        </tr>
        <tr>
            <td class="lbl">Trial Acronym</td>
            <td><div class="type-badge">optional string</div>
                <input data-ctx="C94108" class="fb" type="text" placeholder="Enter Trial Acronym"
                    @bind="Model.C94108" @bind:event="oninput" @bind:after="AutoSave" /></td>
        </tr>
        <tr>
            <td class="lbl req">Sponsor Protocol Identifier:</td>
            <td><div class="type-badge">required string</div>
                <input data-ctx="C132351" class="@ReqInputClass(Model.C132351)" type="text" placeholder="Enter Sponsor Protocol Identifier"
                    @bind="Model.C132351" @bind:event="oninput" @bind:after="AutoSave" /></td>
        </tr>
        <tr>
            <td class="lbl req">Original Protocol:</td>
            <td><div class="type-badge">required picklist — C217046</div>
                <PicklistSelect ValueSetId="m11-yes-no-vs" CssClass="@SelReqClass(Model.C218672)"
                    DataCtx="C218672" Value="@Model.C218672"
                    ValueChanged="@(v => OnOriginalProtocolChanged(new ChangeEventArgs { Value = v }))" /></td>
        </tr>
        <tr>
            <td class="lbl">Version Number:</td>
            <td><div class="type-badge">@(AmendFromStore ? "read-only" : "optional string")</div>
                <div data-ctx-wrap="C181232" style="position:relative">
                <input data-ctx="C181232" class="fb @(AmendFromStore ? "ro-inp" : "")" type="text" placeholder="Enter Version Number"
                    @bind="Model.C181232" @bind:event="oninput" @bind:after="AutoSave" disabled="@AmendFromStore" />
                </div>
            </td>
        </tr>
        <tr>
            <td class="lbl">Version Date:</td>
            <td><div class="type-badge">@(AmendFromStore ? "read-only" : "optional date")</div>
                <div data-ctx-wrap="C93813" style="position:relative">
                <input data-ctx="C93813" class="fb @(AmendFromStore ? "ro-inp" : "")" type="text" placeholder="yyyy-mm-dd"
                    @bind="Model.C93813" @bind:event="oninput" @bind:after="AutoSave" disabled="@AmendFromStore" />
                </div>
            </td>
        </tr>
        <tr class="@((IsAmendment || AmendFromStore) ? "" : "amend-inactive")">
            <td class="lbl cond">Amendment Identifier:</td>
            <td><div class="type-badge">@(AmendFromStore ? "read-only" : "conditional string")</div>
                <div data-ctx-wrap="C218477" style="position:relative">
                <input data-ctx="C218477" class="fb @(AmendFromStore ? "ro-inp" : "")" type="text" placeholder="Enter Amendment Identifier"
                    @bind="Model.C218477" @bind:event="oninput" @bind:after="AutoSave" disabled="@(AmendFromStore || !IsAmendment)" />
                </div>
            </td>
        </tr>
        <tr class="@((IsAmendment || AmendFromStore) ? "" : "amend-inactive")">
            <td class="lbl cond">Amendment Scope:</td>
            <td><div class="type-badge">@(AmendFromStore ? "read-only" : "conditional picklist")</div>
                <div data-ctx-wrap="C218673" style="position:relative">
                <PicklistSelect ValueSetId="m11-study-amendment-scope-vs" CssClass="@("fb-sel" + (AmendFromStore ? " ro-sel" : ""))"
                    DataCtx="C218673" @bind-Value="Model.C218673" @bind-Value:after="AutoSave" />
                </div>
                <div style="margin-top:6px;">
                    <div class="type-badge">Country (@(AmendFromStore ? "read-only" : "conditional picklist"))</div>
                    <div data-ctx-wrap="C20108" style="position:relative">
                    <PicklistSelect ValueSetId="udp-country-vs" CssClass="@("fb-sel" + (AmendFromStore ? " ro-sel" : ""))"
                        DataCtx="C20108" @bind-Value="Model.C20108" @bind-Value:after="AutoSave" />
                    </div>
                </div>
                <div style="margin-top:6px;">
                    <div class="type-badge">Region (@(AmendFromStore ? "read-only" : "conditional picklist"))</div>
                    <div data-ctx-wrap="C218674" style="position:relative">
                    <PicklistSelect ValueSetId="udp-region-vs" CssClass="@("fb-sel" + (AmendFromStore ? " ro-sel" : ""))"
                        DataCtx="C218674" @bind-Value="Model.C218674" @bind-Value:after="AutoSave" />
                    </div>
                </div>
                <div style="margin-top:6px;">
                    <div class="type-badge">Site Identifier (@(AmendFromStore ? "read-only" : "conditional string"))</div>
                    <div data-ctx-wrap="C83081" style="position:relative">
                    <input data-ctx="C83081" class="fb @(AmendFromStore ? "ro-inp" : "")" type="text" placeholder="Enter Site Identifier"
                        @bind="Model.C83081" @bind:event="oninput" @bind:after="AutoSave" disabled="@AmendFromStore" />
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="lbl">Sponsor's Investigational Product Code(s):</td>
            <td><div class="type-badge">optional string</div>
                <input data-ctx="C218675" class="fb" type="text" placeholder="Enter Sponsor IP Code(s)"
                    @bind="Model.C218675" @bind:event="oninput" @bind:after="AutoSave" /></td>
        </tr>
        <tr>
            <td class="lbl">Investigational Product Name(s):</td>
            <td>
                <div class="type-badge">Nonproprietary Name (optional string)</div>
                <input data-ctx="C97054" class="fb" type="text" placeholder="Enter Nonproprietary Name(s)"
                    @bind="Model.C97054" @bind:event="oninput" @bind:after="AutoSave" />
                <div class="type-badge" style="margin-top:6px;">Proprietary Name (optional string)</div>
                <input data-ctx="C71898" class="fb" type="text" placeholder="Enter Proprietary Name(s)"
                    @bind="Model.C71898" @bind:event="oninput" @bind:after="AutoSave" /></td>
        </tr>
        <tr>
            <td class="lbl req">Trial Phase</td>
            <td><div class="type-badge">required picklist</div>
                <PicklistSelect ValueSetId="m11-phase-vs" CssClass="@SelReqClass(Model.C48281)"
                    DataCtx="C48281" @bind-Value="Model.C48281" @bind-Value:after="AutoSave" /></td>
        </tr>
        <tr>
            <td class="lbl">Short Title</td>
            <td><div class="type-badge">optional string</div>
                <textarea data-ctx="C94105" class="fb" rows="2" placeholder="Enter Short Title"
                    @bind="Model.C94105" @bind:event="oninput" @bind:after="AutoSave"></textarea></td>
        </tr>
        <tr>
            <td class="lbl req">Sponsor Name and Address:</td>
            <td>
                <div class="type-badge">Sponsor Name (required string)</div>
                <input data-ctx="C222495" class="@ReqInputClass(Model.C222495)" type="text" placeholder="Enter Sponsor Name"
                    @bind="Model.C222495" @bind:event="oninput" @bind:after="AutoSave" />
                <div class="type-badge" style="margin-top:6px;">Sponsor Legal Address (required string)</div>
                <textarea data-ctx="C218677" class="@ReqClass(Model.C218677)" rows="2" placeholder="Enter Sponsor Legal Address"
                    @bind="Model.C218677" @bind:event="oninput" @bind:after="AutoSave"></textarea></td>
        </tr>
        <tr>
            <td class="lbl">Co-Sponsor Name and Address:</td>
            <td>
                <div class="type-badge">Co-Sponsor Name (optional string)</div>
                <input data-ctx="C218678" class="fb" type="text" placeholder="Enter Co-Sponsor Name"
                    @bind="Model.C218678" @bind:event="oninput" @bind:after="AutoSave" />
                <div class="type-badge" style="margin-top:6px;">Co-Sponsor Legal Address (optional string)</div>
                <textarea data-ctx="C218679" class="fb" rows="2" placeholder="Enter Co-Sponsor Legal Address"
                    @bind="Model.C218679" @bind:event="oninput" @bind:after="AutoSave"></textarea></td>
        </tr>
        <tr>
            <td class="lbl">Local Sponsor Name and Address:</td>
            <td>
                <div class="type-badge">Local Sponsor Name (optional string)</div>
                <input data-ctx="C218680" class="fb" type="text" placeholder="Enter Local Sponsor Name"
                    @bind="Model.C218680" @bind:event="oninput" @bind:after="AutoSave" />
                <div class="type-badge" style="margin-top:6px;">Local Sponsor Legal Address (optional string)</div>
                <textarea data-ctx="C218681" class="fb" rows="2" placeholder="Enter Local Sponsor Legal Address"
                    @bind="Model.C218681" @bind:event="oninput" @bind:after="AutoSave"></textarea></td>
        </tr>
        <tr>
            <td class="lbl">Device Manufacturer Name and Address:</td>
            <td>
                <div class="type-badge">Device Manufacturer Name (optional string)</div>
                <input data-ctx="C218682" class="fb" type="text" placeholder="Enter Device Manufacturer Name"
                    @bind="Model.C218682" @bind:event="oninput" @bind:after="AutoSave" />
                <div class="type-badge" style="margin-top:6px;">Device Manufacturer Address (optional string)</div>
                <textarea data-ctx="C218683" class="fb" rows="2" placeholder="Enter Device Manufacturer Address"
                    @bind="Model.C218683" @bind:event="oninput" @bind:after="AutoSave"></textarea></td>
        </tr>
        <tr>
            <td class="lbl">Regulatory or Clinical Trial Identifier(s):</td>
            <td>
                <div class="type-badge">EU CT Number (optional string)</div>
                <input data-ctx="C218684" class="fb" type="text" placeholder="EU CT Number"   @bind="Model.C218684" @bind:event="oninput" @bind:after="AutoSave" />
                <div class="type-badge" style="margin-top:4px;">FDA IND Number (optional string)</div>
                <input data-ctx="C218685" class="fb" type="text" placeholder="FDA IND Number" @bind="Model.C218685" @bind:event="oninput" @bind:after="AutoSave" />
                <div class="type-badge" style="margin-top:4px;">IDE Number (optional string)</div>
                <input data-ctx="C218686" class="fb" type="text" placeholder="IDE Number"     @bind="Model.C218686" @bind:event="oninput" @bind:after="AutoSave" />
                <div class="type-badge" style="margin-top:4px;">jRCT Number (optional string)</div>
                <input data-ctx="C218687" class="fb" type="text" placeholder="jRCT Number"    @bind="Model.C218687" @bind:event="oninput" @bind:after="AutoSave" />
                <div class="type-badge" style="margin-top:4px;">NCT Number (optional string)</div>
                <input data-ctx="C172240" class="fb" type="text" placeholder="NCT Number"     @bind="Model.C172240" @bind:event="oninput" @bind:after="AutoSave" />
                <div class="type-badge" style="margin-top:4px;">NMPA IND Number (optional string)</div>
                <input data-ctx="C218688" class="fb" type="text" placeholder="NMPA IND Number" @bind="Model.C218688" @bind:event="oninput" @bind:after="AutoSave" />
                <div class="type-badge" style="margin-top:4px;">WHO/UTN Number (optional string)</div>
                <input data-ctx="C218689" class="fb" type="text" placeholder="WHO/UTN Number"  @bind="Model.C218689" @bind:event="oninput" @bind:after="AutoSave" />
                <div class="type-badge" style="margin-top:4px;">Other Regulatory Identifier (optional string)</div>
                <input data-ctx="C218690" class="fb" type="text" placeholder="Other Identifier" @bind="Model.C218690" @bind:event="oninput" @bind:after="AutoSave" /></td>
        </tr>
        <tr>
            <td class="lbl cond">Sponsor Approval:</td>
            <td>
                <div class="type-badge">Approval Date (conditional date)</div>
                <input data-ctx="C132352" class="fb" type="text" placeholder="yyyy-mm-dd" @bind="Model.C132352" @bind:event="oninput" @bind:after="AutoSave" />
                <div class="type-badge" style="margin-top:6px;">Signature Location (conditional string)</div>
                <input data-ctx="C218484" class="fb" type="text" placeholder="State location of sponsor approval information"
                    @bind="Model.C218484" @bind:event="oninput" @bind:after="AutoSave" /></td>
        </tr>
    </table>

    <p style="font-weight:700;margin:14px 0 4px;">Sponsor Signatory</p>
    <table class="tp-tbl">
        <tr>
            <td class="lbl">Sponsor Signatory:</td>
            <td>
                <div class="type-badge">optional string</div>
                <textarea data-ctx="C222014" class="fb" rows="2" placeholder="Enter sponsor signatory (name, title, signature and date)"
                    @bind="Model.C222014" @bind:event="oninput" @bind:after="AutoSave"></textarea>
                <div class="type-badge" style="margin-top:6px;">Location (optional string)</div>
                <input data-ctx="C222064" class="fb" type="text" placeholder="State location where signatory information can be found"
                    @bind="Model.C222064" @bind:event="oninput" @bind:after="AutoSave" /></td>
        </tr>
    </table>

    <p style="font-weight:700;margin:14px 0 4px;">Medical Expert Contact</p>
    <table class="tp-tbl">
        <tr>
            <td class="lbl">Medical Expert Contact:</td>
            <td>
                <div class="type-badge">optional string</div>
                <textarea data-ctx="C218693" class="fb" rows="2" placeholder="Enter Medical Expert contact information"
                    @bind="Model.C218693" @bind:event="oninput" @bind:after="AutoSave"></textarea>
                <div class="type-badge" style="margin-top:6px;">Location (optional string)</div>
                <input data-ctx="C222063" class="fb" type="text" placeholder="State location where Medical Expert contact information can be found"
                    @bind="Model.C222063" @bind:event="oninput" @bind:after="AutoSave" /></td>
        </tr>
    </table>

    <div class="@((IsAmendment || AmendFromStore) ? "h2" : "h2 amend-inactive")" style="@((IsAmendment || AmendFromStore) ? "" : "color:#aaa;")">Amendment Details @((IsAmendment || AmendFromStore) ? "" : "(inactive — set Original Protocol to No)")</div>
    <div class="@((IsAmendment || AmendFromStore) ? "" : "amend-inactive")">
    <table class="tp-tbl">
        <tr>
            <td class="lbl cond">Amendment Status:</td>
            <td><div class="type-badge">@(AmendFromStore ? "read-only" : "conditional picklist")</div>
                <div data-ctx-wrap="C218694" style="position:relative">
                <PicklistSelect ValueSetId="m11-amendment-status-vs" CssClass="@("fb-sel" + (AmendFromStore ? " ro-sel" : ""))"
                    DataCtx="C218694" @bind-Value="Model.C218694" @bind-Value:after="AutoSave" />
                </div>
            </td>
        </tr>
    </table>

    <p style="font-style:italic;font-size:10pt;color:#555;margin:6px 0 12px;">The table below describes the current amendment. Complete only if an amendment applies.</p>

    <table class="tp-tbl">
        <tr>
            <td class="lbl cond">Amendment Identifier:</td>
            <td><div class="type-badge">read-only</div>
                <span style="display:block;padding:3px 5px;font-size:10.5pt;">@Model.C218477</span></td>
        </tr>
        <tr>
            <td class="lbl cond">Amendment Scope:</td>
            <td><div class="type-badge">read-only</div>
                <span style="display:block;padding:3px 5px;font-size:10.5pt;">@Model.C218673</span></td>
        </tr>
    </table>

    <table class="tp-tbl">
        <tr>
            <td class="lbl cond">Approx. Enrolled at Time of Sponsor Approval:</td>
            <td>
                <div class="type-badge">@(AmendFromStore ? "read-only" : "conditional quantity")</div>
                <div data-ctx-wrap="C218478" style="position:relative">
                <input data-ctx="C218478" class="fb @(AmendFromStore ? "ro-inp" : "")" type="text" placeholder="Approximately #/% enrolled"
                    @bind="Model.C218478" @bind:event="oninput" @bind:after="AutoSave" disabled="@AmendFromStore" />
                </div>
                <div class="type-badge" style="margin-top:6px;">Amendment Scope Enrollment Definition (@(AmendFromStore ? "read-only" : "conditional picklist"))</div>
                <div data-ctx-wrap="C218695" style="position:relative">
                <PicklistSelect ValueSetId="m11-amendment-scope-enrollment-vs" CssClass="@("fb-sel" + (AmendFromStore ? " ro-sel" : ""))"
