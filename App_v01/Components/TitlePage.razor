</div>

<div id="tp-ctx-menu" class="ctx-menu">
    <div class="ctx-hdr"><span>Field Information</span><button class="ctx-close" @onclick="CloseCtxMenu">✕</button></div>
    <div class="ctx-body">
        <div class="ctx-row"><label>M11 Field Name:</label><span>@CtxFieldName</span></div>
        <div class="ctx-row"><label>M11 Name:</label><span>@CtxM11Name</span></div>
        @if (!string.IsNullOrEmpty(CtxValueSetId))
        {
            <div class="ctx-row"><label>M11 code set:</label><span>@CtxValueSetCCode</span></div>
            <div class="ctx-row"><label>Value Set:</label><span>@CtxValueSetName</span></div>
        }
        <hr class="ctx-div" />
        <div class="ctx-guide"><strong>Guidance:</strong><br />@CtxGuidance</div>
    </div>
</div>

@* ── Amendment Picker Dialog ────────────────────────────────────── *@
<div class="overlay @AmendPickerCss">
    <div class="dbox" style="width:480px;">
        <h3>Select Current Amendment</h3>
        <p style="font-size:10pt;color:#555;margin-bottom:12px;">
            This document is an amendment. Select which amendment set describes this version.
        </p>
        @if (AmendStore.All.Count == 0)
        {
            <div class="ap-empty">No amendment sets exist yet.</div>
            <button class="ap-create-link" style="text-decoration:none;background:#1f3864;color:#fff;border:none;border-radius:3px;padding:7px 18px;margin:8px auto;display:block;cursor:pointer;"
                    @onclick="GoToAmendments">
                + Create amendments on the Amendment Details page
            </button>
        }
        else
        {
            <ul class="ap-list">
                @foreach (var rec in AmendStore.All)
                {
                    var r = rec;
                    <li>
                        <span class="ap-item-name">@r.Name</span>
                        @if (!string.IsNullOrWhiteSpace(r.C218477))
                        {
                            <span class="ap-item-meta">ID: @r.C218477</span>
                        }
                        <button class="ap-select-btn" @onclick="() => ApplyAmendment(r)">Select</button>
                    </li>
                }
            </ul>
            <button class="ap-create-link" @onclick="GoToAmendments">
                + Add more amendments on the Amendment Details page
            </button>
        }
        <div class="dbr" style="margin-top:16px;">
            <button class="btn btn-secondary" @onclick="CancelAmendPicker">Cancel</button>
        </div>
    </div>
</div>

<FhirPipelineDialog @ref="_pipeline" />

<div class="overlay @SaveDialogCss">
    <div class="dbox">
        <h3>Save Data to File</h3>
        <label style="display:block;font-weight:700;margin-bottom:6px;">File name</label>
        <input type="text" @bind="SaveFileName" @bind:event="oninput" @bind:after="AutoSave" />
        <label style="display:block;font-weight:700;margin:10px 0 6px;">Format</label>
        <div class="fmt-row">
            <label><input type="radio" name="tpfmt" checked="@IsPipeline" @onchange="SetFmtPipeline" /> FHIR</label>
            <label><input type="radio" name="tpfmt" checked="@IsFhir"     @onchange="SetFmtFhir"     /> FSH</label>
            <label><input type="radio" name="tpfmt" checked="@IsJson"     @onchange="SetFmtJson"     /> JSON</label>
            <label><input type="radio" name="tpfmt" checked="@IsCsv"      @onchange="SetFmtCsv"      /> CSV</label>
            <label><input type="radio" name="tpfmt" checked="@IsTxt"      @onchange="SetFmtTxt"      /> Plain Text</label>
        </div>
        <div class="dbr">
            <button class="btn btn-secondary" @onclick="CloseSaveDialog">Cancel</button>
            <button class="btn btn-primary"   @onclick="DoSaveToFile">@(IsPipeline ? "Publish" : "Download")</button>
        </div>
    </div>
</div>

<div class="overlay @ReqDialogCss">
    <div class="dbox">
        <h3 style="color:#c00;">Incomplete Required Fields</h3>
        <p>@ReqDialogMsg</p>
        <div class="dbr">
            <button class="btn btn-secondary" @onclick="CloseReqDialog">Cancel</button>
            <button class="btn btn-primary" style="background:#c00;" @onclick="ForceConfirm">Save Anyway</button>
        </div>
    </div>
</div>

<!-- ── Clear confirmation modal ──────────────────────────────────────────── -->
<div class="overlay @(_showClearConfirm ? "show" : "")">
    <div class="dbox">
        <h3>Clear All Data</h3>
        <p>This will remove all entered data for the Title Page. Are you sure?</p>
        <div class="dbr">
            <button class="btn btn-secondary" @onclick="() => _showClearConfirm = false">Cancel</button>
            <button class="btn btn-danger"    @onclick="DoClearAll">Clear All</button>
        </div>
    </div>
</div>

<div class="sbar">
    <span>Title Page – Data Entry &nbsp;|&nbsp; <span style='color:#c8a0e8'>Purple</span> = placeholder &nbsp;|&nbsp; <span style='color:#6dbf6d'>Green</span> = user entry &nbsp;|&nbsp; <span style='background:#f5d0d0;padding:0 3px'>Pink</span> = required &nbsp;|&nbsp; Right-click field for info</span>
    <span>@StatusMessage</span>
</div>

@code {
    private TitlePageModel Model = new();
    private List<int> ChgRows = new() { 1 };
    private int _nextChgRow = 2;
    private bool   ShowValidation    = false;
    private bool   ShowSaveDialog    = false;
    private bool   ShowReqDialog     = false;
    private bool   _showClearConfirm = false;
    private string SaveFileName   = "title_page_data";
    private string SaveFormat     = "fhir-pipeline";
    private FhirPipelineDialog _pipeline = default!;
    private string StatusMessage  = string.Empty;
    private string ReqDialogMsg   = string.Empty;
    private string ErrorMessage   = string.Empty;
    private string? PendingAction = null;
    private string CtxFieldName = string.Empty, CtxM11Name = string.Empty, CtxGuidance = string.Empty, CtxValueSetId = string.Empty, CtxValueSetName = string.Empty, CtxValueSetCCode = string.Empty;

    private static readonly Dictionary<string, string> FieldValueSets = new()
    {
        ["C218672"] = "m11-yes-no-vs",           // Original Protocol (Yes/No)
        ["C48281"]  = "m11-phase-vs",     // Trial Phase
        ["C218673"] = "m11-study-amendment-scope-vs",    // Amendment Scope
        ["C20108"]  = "udp-country-vs",          // Country
        ["C218674"] = "udp-region-vs",           // Region
        ["C218694"] = "m11-amendment-status-vs",// Amendment Status
        ["C218695"] = "m11-amendment-scope-enrollment-vs",// Enrollment Scope
        ["C218696"] = "m11-study-amendment-reason-vs", // Primary Reason for Amendment
        ["C218697"] = "m11-study-amendment-reason-vs", // Secondary Reason for Amendment
        ["C218698"] = "m11-yes-no-vs",           // Substantial Impact on Safety or Rights
        ["C218700"] = "m11-yes-no-vs",           // Substantial Impact on Reliability
        ["C218479"] = "m11-protocol-section-vs",// Protocol Section (change log)
    };
    private System.Threading.Timer? _statusTimer;
    private DotNetObjectReference<TitlePage>? _objRef;

    private bool ShowAmendPicker = false;
    private string SaveDialogCss    => ShowSaveDialog  ? "show" : "";
    private string ReqDialogCss     => ShowReqDialog   ? "show" : "";
    private string AmendPickerCss   => ShowAmendPicker ? "show" : "";

    /// <summary>True when C218672 is "No" — i.e. this document IS an amendment (not the original protocol).</summary>
    private bool IsAmendment =>
        !string.IsNullOrWhiteSpace(Model.C218672) &&
        Model.C218672.Contains("C49487", StringComparison.OrdinalIgnoreCase);

    /// <summary>True when amendment data was auto-filled from AmendmentStore — fields are read-only but not greyed.</summary>
    private bool AmendFromStore => AmendStore.All.Count > 0;

    private void OnOriginalProtocolChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        Model.C218672 = val;
        if (IsAmendment)
            ShowAmendPicker = true;
        else
        {
            // Cleared back to Yes / blank — clear amendment fields
            Model.C218477 = null; Model.C218673 = null; Model.C20108  = null;
            Model.C218674 = null; Model.C83081  = null; Model.C218694 = null;
            Model.C218478 = null; Model.C218695 = null; Model.C218874 = null;
            Model.C218696 = null; Model.C218697 = null; Model.C17649  = null;
            Model.C17649_2 = null; Model.C42581 = null; Model.C218698 = null;
            Model.C218699 = null; Model.C218700 = null; Model.C218701 = null;
            Model.ChgData.Clear(); ChgRows = new() { 1 }; _nextChgRow = 2;
        }
        AutoSave();
    }

    private void ApplyAmendment(UDP_App.Models.AmendmentRecord rec)
    {
        Model.C181232  = rec.C181232;
        Model.C93813   = rec.C93813;
        Model.C218477  = rec.C218477;
        Model.C218673  = rec.C218673;
        Model.C20108   = rec.C20108;
        Model.C218674  = rec.C218674;
        Model.C83081   = rec.C83081;
        Model.C218694  = rec.C218694;
        Model.C218478  = rec.C218478;
        Model.C218695  = rec.C218695;
        Model.C218874  = rec.C218874;
        Model.C218696  = rec.C218696;
        Model.C218697  = rec.C218697;
        Model.C17649   = rec.C17649;
        Model.C17649_2 = rec.C17649_2;
        Model.C42581   = rec.C42581;
        Model.C218698  = rec.C218698;
        Model.C218699  = rec.C218699;
        Model.C218700  = rec.C218700;
        Model.C218701  = rec.C218701;
        Model.ChgData  = new Dictionary<string, string>(rec.ChgData);
        Model.ChgRows  = rec.ChgRows;
        ChgRows        = Enumerable.Range(1, Math.Max(1, rec.ChgRows)).ToList();
        _nextChgRow    = ChgRows.Max() + 1;
        ShowAmendPicker = false;
        SetStatus($"✓ Amendment '{rec.Name}' applied");
    }

    private void CancelAmendPicker()
    {
        ShowAmendPicker = false;
        // Revert the C218672 selection back to blank so the form isn't misleadingly locked
        Model.C218672 = null;
    }

    private void GoToAmendments()
    {
        ShowAmendPicker = false;
        Nav.NavigateTo("/amendments");
    }
    private bool IsPipeline => SaveFormat == "fhir-pipeline";
    private bool IsFhir => SaveFormat == "fsh";
    private bool IsJson => SaveFormat == "json"; private bool IsCsv  => SaveFormat == "csv";
    private bool IsTxt  => SaveFormat == "txt";
    private void SetFmtPipeline(ChangeEventArgs e) => SaveFormat = "fhir-pipeline";
    private void SetFmtJson(ChangeEventArgs e) => SaveFormat = "json";
    private void SetFmtCsv(ChangeEventArgs e)  => SaveFormat = "csv";
    private void SetFmtTxt(ChangeEventArgs e)  => SaveFormat = "txt";
    private void SetFmtFhir(ChangeEventArgs e) => SaveFormat = "fsh";

    private string ReqClass(string? v)      => string.IsNullOrWhiteSpace(v) ? "fb req-empty" : "fb";
    private string ReqInputClass(string? v) => string.IsNullOrWhiteSpace(v) ? "fb req-empty" : "fb";
    private string SelReqClass(string? v)   => string.IsNullOrWhiteSpace(v) ? "fb-sel req-empty" : "fb-sel";

    private string GetChg(string key) => Model.ChgData.TryGetValue(key, out var v) ? v : string.Empty;
    private void SetChg(string key, string? val) { Model.ChgData[key] = val ?? string.Empty; }

    private void AddChgRow()
    {
        var r = _nextChgRow++;
        ChgRows.Add(r);
        Model.ChgRows = ChgRows.Count;
    }

    private void DeleteChgRow(int r)
    {
        ChgRows.Remove(r);
        var keys = Model.ChgData.Keys.Where(k => k.EndsWith($"_r{r}")).ToList();
        foreach (var k in keys) Model.ChgData.Remove(k);
        Model.ChgRows = ChgRows.Count;
    }

    private RenderFragment ReasonSelect(string ctxId, string? current, Action<string?> setter, bool readOnly = false) => __builder =>
    {
        var opts = new[]
        {
            ("$NCIT#C218490 \"Regulatory Agency Request To Amend\"", "Regulatory Agency Request To Amend"),
            ("$NCIT#C218491 \"New Regulatory Guidance\"",           "New Regulatory Guidance"),
            ("$NCIT#C218492 \"IRB/IEC Feedback\"",                  "IRB/IEC Feedback"),
            ("$NCIT#C218493 \"New Safety Information Available\"",   "New Safety Information Available"),
            ("$NCIT#C218494 \"Manufacturing Change\"",              "Manufacturing Change"),
            ("$NCIT#C218495 \"IMP Addition\"",                      "IMP Addition"),
            ("$NCIT#C218496 \"Change In Strategy\"",                "Change In Strategy"),
            ("$NCIT#C218497 \"Change In Standard Of Care\"",        "Change In Standard Of Care"),
            ("$NCIT#C218498 \"New Data Available (Other Than Safety Data)\"", "New Data Available (Other Than Safety Data)"),
            ("$NCIT#C218499 \"Investigator/Site Feedback\"",        "Investigator/Site Feedback"),
            ("$NCIT#C218500 \"Recruitment Difficulty\"",            "Recruitment Difficulty"),
            ("$NCIT#C218501 \"Inconsistency And/Or Error In The Protocol\"", "Inconsistency And/Or Error In The Protocol"),
            ("$NCIT#C218502 \"Protocol Design Error\"",             "Protocol Design Error"),
            ("$NCIT#C17649 \"Other\"",                              "Other"),
            ("$NCIT#C48660 \"Not Applicable\"",                     "Not Applicable"),
        };
        <select data-ctx="@ctxId" class="fb-sel @(readOnly ? "ro-sel" : "")" value="@current"
            @onchange="@(e => setter(e.Value?.ToString()))" disabled="@readOnly">
            <option value="">-- select --</option>
            @foreach (var (val, lbl) in opts)
            {
                <option value="@val">@lbl</option>
            }
        </select>;
    };

    private bool PrimaryOtherActive =>
        !string.IsNullOrWhiteSpace(Model.C218696) &&
        Model.C218696.Contains("C17649", StringComparison.OrdinalIgnoreCase);

    private bool SecondaryOtherActive =>
        !string.IsNullOrWhiteSpace(Model.C218697) &&
        Model.C218697.Split(';', StringSplitOptions.RemoveEmptyEntries)
             .Any(v => v.Trim().Contains("C17649"));

    private RenderFragment ReasonMultiSelect(string ctxId, string? current, Action<string?> setter, bool readOnly = false) => __builder =>
    {
        var opts = new[]
        {
            ("$NCIT#C218490 \"Regulatory Agency Request To Amend\"", "Regulatory Agency Request To Amend"),
            ("$NCIT#C218491 \"New Regulatory Guidance\"",           "New Regulatory Guidance"),
            ("$NCIT#C218492 \"IRB/IEC Feedback\"",                  "IRB/IEC Feedback"),
            ("$NCIT#C218493 \"New Safety Information Available\"",   "New Safety Information Available"),
            ("$NCIT#C218494 \"Manufacturing Change\"",              "Manufacturing Change"),
            ("$NCIT#C218495 \"IMP Addition\"",                      "IMP Addition"),
            ("$NCIT#C218496 \"Change In Strategy\"",                "Change In Strategy"),
            ("$NCIT#C218497 \"Change In Standard Of Care\"",        "Change In Standard Of Care"),
            ("$NCIT#C218498 \"New Data Available (Other Than Safety Data)\"", "New Data Available (Other Than Safety Data)"),
            ("$NCIT#C218499 \"Investigator/Site Feedback\"",        "Investigator/Site Feedback"),
            ("$NCIT#C218500 \"Recruitment Difficulty\"",            "Recruitment Difficulty"),
            ("$NCIT#C218501 \"Inconsistency And/Or Error In The Protocol\"", "Inconsistency And/Or Error In The Protocol"),
            ("$NCIT#C218502 \"Protocol Design Error\"",             "Protocol Design Error"),
            ("$NCIT#C17649 \"Other\"",                              "Other"),
            ("$NCIT#C48660 \"Not Applicable\"",                     "Not Applicable"),
        };
        var selected = (current ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries)
                                      .Select(v => v.Trim()).ToHashSet();
        @if (readOnly)
        {
            // Read-only: show as a disabled multi-select list so coded values are preserved
            <select data-ctx="@ctxId" class="fb-sel ro-sel" multiple disabled
                style="height:auto;min-height:60px;">
                @foreach (var (val, lbl) in opts)
                {
                    @if (selected.Contains(val))
                    {
                        <option value="@val" selected>@lbl</option>
                    }
                }
            </select>;
        }
        else
        {
            <div data-ctx="@ctxId" style="display:flex;flex-direction:column;gap:3px;padding:4px 0;">
            @foreach (var (val, lbl) in opts)
            {
                var isChecked = selected.Contains(val);
                var capturedVal = val;
                <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:10.5pt;padding:1px 0;">
                    <input type="checkbox" checked="@isChecked"
                        @onchange="@(e => {
                            var nowChecked = (bool)(e.Value ?? false);
                            if (nowChecked) selected.Add(capturedVal);
                            else            selected.Remove(capturedVal);
                            setter(string.Join(";", selected));
                        })" />
                    @lbl
                </label>
            }
            </div>;
        }
    };

    private bool HasRequiredEmpty() =>
        new[] { Model.C132346, Model.C132351, Model.C218672, Model.C48281, Model.C222495, Model.C218677 }
            .Any(string.IsNullOrWhiteSpace);

    private int RequiredEmptyCount() =>
        new[] { Model.C132346, Model.C132351, Model.C218672, Model.C48281, Model.C222495, Model.C218677 }
            .Count(string.IsNullOrWhiteSpace);

    private void ClearAll() => _showClearConfirm = true;

    private void DoClearAll()
    {
        _showClearConfirm = false;
        Model = new(); ChgRows = new List<int> { 1 }; _nextChgRow = 2;
        ShowValidation = false; ErrorMessage = string.Empty;
        _ = JS.InvokeVoidAsync("localStorage.removeItem", "tpdata");
        SetStatus("Cleared");
    }

    private void LoadSample()
    {
        var s = DataSvc.LoadSample();
        if (s != null)
        {
            Model = s;
            ChgRows = Enumerable.Range(1, Math.Max(1, s.ChgRows)).ToList();
            _nextChgRow = ChgRows.Max() + 1;
            ShowValidation = false; SetStatus("Sample data loaded"); AutoSave();
        }
        else ErrorMessage = "Could not load sample file.";
    }

    private async Task SaveToBrowser()
    {
        ShowValidation = true;
        if (HasRequiredEmpty()) { ReqDialogMsg = $"{RequiredEmptyCount()} required field(s) empty."; PendingAction = "browser"; ShowReqDialog = true; return; }
        await DoBrowserSave();
    }

    private void AutoSave() =>
        _ = JS.InvokeVoidAsync("localStorage.setItem", "tpdata", DataSvc.ToJson(Model));

    private async Task DoBrowserSave()
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", "tpdata", DataSvc.ToJson(Model)); SetStatus("✓ Saved " + DateTime.Now.ToShortTimeString()); }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }

    private void OpenSaveDialog()
    {
        ShowValidation = true;
        if (HasRequiredEmpty()) { ReqDialogMsg = $"{RequiredEmptyCount()} required field(s) empty."; PendingAction = "file"; ShowReqDialog = true; return; }
        SaveFileName = "title_page_data_" + DateTime.Now.ToString("yyyy-MM-dd"); ShowSaveDialog = true;
    }

    private void CloseSaveDialog() => ShowSaveDialog = false;
    private void CloseReqDialog()  { ShowReqDialog = false; PendingAction = null; }

    private async Task ForceConfirm()
    {
        ShowReqDialog = false;
        if (PendingAction == "browser") await DoBrowserSave();
        else if (PendingAction == "file") { SaveFileName = "title_page_data_" + DateTime.Now.ToString("yyyy-MM-dd"); ShowSaveDialog = true; }
        PendingAction = null;
    }

    private async Task DoSaveToFile()
    {
        ShowSaveDialog = false;
        if (SaveFormat == "fhir-pipeline")
        {
            var fshContent = DataSvc.ToFsh(Model);
            var baseName   = SaveFileName.Trim().Length > 0 ? SaveFileName.Trim() : "title_page_data";
            await _pipeline.RunAsync(baseName + ".fsh", fshContent);
            SetStatus("✓ FHIR pipeline complete");
            return;
        }
        var (content, mime, ext) = SaveFormat switch
        {
            "csv"  => (DataSvc.ToCsv(Model),      "text/csv",         ".csv"),
            "txt"  => (DataSvc.ToPlainText(Model), "text/plain",       ".txt"),
            "fsh"  => (DataSvc.ToFsh(Model),       "text/plain",       ".fsh"),
            _      => (DataSvc.ToJson(Model),      "application/json", ".json"),
        };
        var fn = (SaveFileName.Trim().Length > 0 ? SaveFileName.Trim() : "title_page_data") + ext;
        if (SaveFormat == "fsh") SushiSvc.SaveToExamples(fn, content);
        await JS.InvokeVoidAsync("udpDownload", fn, content, mime);
        SetStatus("⬇ Downloaded " + fn);
    }

    private async Task OpenLoadDialog() => await JS.InvokeVoidAsync("udpOpenFilePicker");

    [JSInvokable] public void ReceiveFileContent(string json)
    {
        var l = DataSvc.FromJson(json);
        if (l != null)
        {
            Model = l;
            ChgRows = Enumerable.Range(1, Math.Max(1, l.ChgRows)).ToList();
            _nextChgRow = ChgRows.Max() + 1;
            ShowValidation = false; SetStatus("⬆ Loaded from file"); AutoSave(); InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable] public async Task OnContextMenuJS(string fieldId, double x, double y)
    {
        CtxFieldName = fieldId; CtxM11Name = FieldTerms.For(fieldId); CtxGuidance = FieldGuidance.For(fieldId);
        var baseId      = System.Text.RegularExpressions.Regex.Replace(fieldId, @"_r\d+$", "");
        CtxValueSetId    = FieldValueSets.TryGetValue(baseId, out var vsId) ? vsId : string.Empty;
        var vs           = string.IsNullOrEmpty(CtxValueSetId) ? null : TermSvc.Get(CtxValueSetId);
        CtxValueSetCCode = vs?.CCode ?? string.Empty;
        CtxValueSetName  = vs == null ? string.Empty : $"{vs.Name}  {vs.Id}";
        StateHasChanged(); await JS.InvokeVoidAsync("udpShowCtxMenu", "tp-ctx-menu", x, y);
    }
    [JSInvokable] public void OnCtxMenuClosed() { }
    private void CloseCtxMenu() => _ = JS.InvokeVoidAsync("udpHideCtxMenu", "tp-ctx-menu");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("udpSetDotNetRef", _objRef, "tp-ctx-menu");
            await JS.InvokeVoidAsync("udpInitContextMenus", "tp-ctx-menu");
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "tpdata");
            if (!string.IsNullOrEmpty(json))
            {
                var l = DataSvc.FromJson(json);
                if (l != null)
                {
                    Model = l;
                    ChgRows = Enumerable.Range(1, Math.Max(1, l.ChgRows)).ToList();
                    _nextChgRow = ChgRows.Max() + 1;
                    StateHasChanged();
                }
            }
            // If amendment records exist, fill amendment fields from the most recent record
            if (AmendStore.All.Count > 0)
            {
                var latest = AmendStore.All[AmendStore.All.Count - 1];
                ApplyAmendment(latest);
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException) { } catch (TaskCanceledException) { }
        catch (Exception ex) { ErrorMessage = "Init error: " + ex.Message; StateHasChanged(); }
    }

    private void SetStatus(string msg)
    {
        StatusMessage = msg; _statusTimer?.Dispose();
        _statusTimer = new System.Threading.Timer(_ => { StatusMessage = string.Empty; InvokeAsync(StateHasChanged); }, null, 4000, System.Threading.Timeout.Infinite);
    }

    public void Dispose() { _objRef?.Dispose(); _statusTimer?.Dispose(); }
}
