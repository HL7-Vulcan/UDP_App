@using UDP_App.Models
@inject IJSRuntime JS

@{
    var def = Defs[TypeName];
    var objFieldId = $"field_3_{def.Prefix}_{ObjIndex:D2}_01_{def.ObjCode}";
}

<!-- Objective heading -->
<p style="font-family:'Times New Roman',Times,serif;font-size:12pt;font-weight:700;margin:0 0 6px;">
    @def.Label #@ObjIndex
</p>

<!-- Objective description textarea -->
<div class="field-wrap">
    <span class="fid-tip">@objFieldId</span>
    <textarea class="fb @(IsObjRequired() && string.IsNullOrWhiteSpace(Block.ObjectiveText) ? "req-empty" : "")"
              id="@objFieldId" title="@objFieldId"
              placeholder="@def.ObjPlaceholder"
              rows="2"
              @bind="Block.ObjectiveText"
              @bind:event="oninput"
              @bind:after="OnObjectiveChanged"
              @oncontextmenu:preventDefault="true"
              @oncontextmenu="@(e => OnContextMenu(e, objFieldId, GetGuidance(TypeName, "obj")))">
    </textarea>
</div>

<!-- Estimands table label -->
<p class="ice-label">Table of Estimand(s)</p>

<!-- Estimands table -->
<table class="est-tbl">
    <thead>
        <tr class="col-hdr">
            <th style="width:38%">Estimand Characteristic</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @{
            var estF2Id = $"field_3_{def.Prefix}_{ObjIndex:D2}_02_C70833";
            var estF3Id = $"field_3_{def.Prefix}_{ObjIndex:D2}_03_C49236";
            var estF4Id = $"field_3_{def.Prefix}_{ObjIndex:D2}_04_C25212";
            var estF5Id = $"field_3_{def.Prefix}_{ObjIndex:D2}_05_C188853";
        }
        <tr>
            <td class="lbl">Population</td>
            <td>
                <div class="field-wrap">
                    <span class="fid-tip">@estF2Id</span>
                    <textarea class="fb" id="@estF2Id" title="@estF2Id" placeholder="List conditions / diseases" rows="2"
                              @bind="Block.C70833" @bind:event="oninput" @bind:after="Changed"
                              @oncontextmenu:preventDefault="true"
                              @oncontextmenu="@(e => OnContextMenu(e, estF2Id, GetGuidance(TypeName, "population")))">
                    </textarea>
                </div>
            </td>
        </tr>
        <tr>
            <td class="lbl">Treatment</td>
            <td>
                <div class="field-wrap">
                    <span class="fid-tip">@estF3Id</span>
                    <textarea class="fb" id="@estF3Id" title="@estF3Id" placeholder="List the treatments / interventions for this objective" rows="2"
                              @bind="Block.C49236" @bind:event="oninput" @bind:after="Changed"
                              @oncontextmenu:preventDefault="true"
                              @oncontextmenu="@(e => OnContextMenu(e, estF3Id, GetGuidance(TypeName, "treatment")))">
                    </textarea>
                </div>
            </td>
        </tr>
        <tr>
            <td class="lbl">Endpoint</td>
            <td>
                <div class="field-wrap">
                    <span class="fid-tip">@estF4Id</span>
                    <textarea class="fb @(IsEndpointRequired() && string.IsNullOrWhiteSpace(Block.C25212) ? "req-empty" : "")"
                              id="@estF4Id" title="@estF4Id"
                              placeholder="Describe the change from baseline to [timepoint] in [health measurement/outcome]" rows="2"
                              @bind="Block.C25212" @bind:event="oninput" @bind:after="Changed"
                              @oncontextmenu:preventDefault="true"
                              @oncontextmenu="@(e => OnContextMenu(e, estF4Id, GetGuidance(TypeName, "endpoint")))">
                    </textarea>
                </div>
            </td>
        </tr>
        <tr>
            <td class="lbl">Population-level summary</td>
            <td>
                <div class="field-wrap">
                    <span class="fid-tip">@estF5Id</span>
                    <textarea class="fb" id="@estF5Id" title="@estF5Id" placeholder="Describe the difference in mean changes between treatment conditions" rows="2"
                              @bind="Block.C188853" @bind:event="oninput" @bind:after="Changed"
                              @oncontextmenu:preventDefault="true"
                              @oncontextmenu="@(e => OnContextMenu(e, estF5Id, GetGuidance(TypeName, "summary")))">
                    </textarea>
                </div>
            </td>
        </tr>
    </tbody>
</table>

<!-- ICE table -->
<p class="ice-label">Table of Intercurrent Events and Strategies (optional)</p>
<table class="ice-tbl">
    <thead>
        <tr>
            <th>Intercurrent Event</th>
            <th>Strategy</th>
        </tr>
    </thead>
    <tbody>
        @for (int r = 0; r < Block.IceRows.Count; r++)
        {
            var rowIdx = r;
            var rowNum = r + 1;
            var iceEventId    = $"field_3_{def.Prefix}_ice_{ObjIndex}_{rowNum}_C188856";
            var iceStrategyId = $"field_3_{def.Prefix}_ice_{ObjIndex}_{rowNum}_C188857";
            var row = Block.IceRows[rowIdx];

            <tr>
                <td>
                    <div class="field-wrap">
                        <span class="fid-tip">@iceEventId</span>
                        <textarea class="fb @(IsIceRequired(row, isEvent: true) ? "req-empty" : "")"
                                  id="@iceEventId" title="@iceEventId"
                                  placeholder="Describe intercurrent event" rows="2"
                                  @bind="row.C188856" @bind:event="oninput" @bind:after="Changed"
                                  @oncontextmenu:preventDefault="true"
                                  @oncontextmenu="@(e => OnContextMenu(e, iceEventId, GetGuidance(TypeName, "ice_event")))">
                        </textarea>
                    </div>
                </td>
                <td>
                    <div class="field-wrap">
                        <span class="fid-tip">@iceStrategyId</span>
                        <textarea class="fb @(IsIceRequired(row, isEvent: false) ? "req-empty" : "")"
                                  id="@iceStrategyId" title="@iceStrategyId"
                                  placeholder="Describe strategy for dealing with intercurrent event" rows="2"
                                  @bind="row.C188857" @bind:event="oninput" @bind:after="Changed"
                                  @oncontextmenu:preventDefault="true"
                                  @oncontextmenu="@(e => OnContextMenu(e, iceStrategyId, GetGuidance(TypeName, "ice_strategy")))">
                        </textarea>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
<button class="add-btn small" @onclick="AddIceRow">+ Add Row</button>

@code {
    [Parameter, EditorRequired] public string TypeName { get; set; } = "primary";
    [Parameter, EditorRequired] public int ObjIndex { get; set; }
    [Parameter, EditorRequired] public ObjectiveBlock Block { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<CtxMenuArgs> OnRightClick { get; set; }

    private Task Changed() => OnChanged.InvokeAsync();

    private Task OnObjectiveChanged()
    {
        // re-evaluate required state on endpoint when objective changes (secondary/exploratory)
        return OnChanged.InvokeAsync();
    }

    private bool IsObjRequired() => TypeName == "primary";

    private bool IsEndpointRequired()
    {
        if (TypeName == "primary") return true;
        return !string.IsNullOrWhiteSpace(Block.ObjectiveText);
    }

    private static bool IsIceRequired(IceRow row, bool isEvent)
    {
        // If partner has content, this field is required
        var partner = isEvent ? row.C188857 : row.C188856;
        var self    = isEvent ? row.C188856 : row.C188857;
        return !string.IsNullOrWhiteSpace(partner) && string.IsNullOrWhiteSpace(self);
    }

    private void AddIceRow()
    {
        Block.IceRows.Add(new IceRow());
        OnChanged.InvokeAsync();
    }

    private Task OnContextMenu(Microsoft.AspNetCore.Components.Web.MouseEventArgs e, string fieldId, string guidance)
    {
        return OnRightClick.InvokeAsync(new CtxMenuArgs
        {
            FieldId  = fieldId,
            Guidance = guidance,
            X = $"{e.ClientX}px",
            Y = $"{e.ClientY}px",
        });
    }

    // ─── Field definitions ────────────────────────────────────────────────────
    private record ObjDef(string Label, string Prefix, string ObjCode, string ObjPlaceholder);

    private static readonly Dictionary<string, ObjDef> Defs = new()
    {
        ["primary"]     = new("Primary Objective",     "01", "C85826",  "Describe the primary objective of this study"),
        ["secondary"]   = new("Secondary Objective",   "02", "C85827",  "Describe the secondary objective of this study"),
        ["exploratory"] = new("Exploratory Objective", "03", "C163559", "Describe the exploratory objective of this study"),
    };

    private static string GetGuidance(string typeName, string slot) => slot switch
    {
        "obj"          => typeName == "primary"
                            ? "<strong>Required.</strong> Describe the primary objective of this study."
                            : "<strong>Optional.</strong> If provided, the Endpoint field becomes required.",
        "population"   => "<strong>Optional.</strong> List the conditions / diseases defining the target population for this estimand.",
        "treatment"    => "<strong>Optional.</strong> List the treatments or interventions for this objective.",
        "endpoint"     => typeName == "primary"
                            ? "<strong>Required.</strong> Describe the change from baseline to a specified timepoint in the primary health measurement."
                            : "<strong>Conditional.</strong> Required if the objective description field has content.",
        "summary"      => "<strong>Optional.</strong> Describe the population-level summary statistic for this estimand.",
        "ice_event"    => "<strong>Conditional.</strong> Required if the Strategy field in this row has content.",
        "ice_strategy" => "<strong>Conditional.</strong> Required if the Intercurrent Event field in this row has content.",
        _              => string.Empty,
    };
}
