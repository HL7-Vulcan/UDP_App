@page "/section-09"
@layout MainLayout
@using UDP_App.Models
@using UDP_App.Services
@inject DataService09 DataSvc
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Section 9 – Data Entry</PageTitle>

<style>
    .doc-page {
        background:#fff; width:794px; min-height:1123px;
        margin:30px auto 80px; padding:72px;
        box-shadow:0 4px 24px rgba(0,0,0,0.18);
        font-family:'Calibri',Arial,sans-serif; font-size:11pt; color:#000;
    }
    .h1 { font-family:'Times New Roman',Times,serif; font-size:14pt; font-weight:700; margin:0 0 18px; }
    .h2 { font-family:'Times New Roman',Times,serif; font-size:14pt; font-weight:700; margin:24px 0 10px; }
    .h3 { font-family:'Times New Roman',Times,serif; font-size:12pt; font-weight:700; margin:18px 0 8px; }
    .h4  { font-family:'Times New Roman',Times,serif; font-size:12pt; font-weight:700; margin:14px 0 6px; display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .h4p { font-family:'Times New Roman',Times,serif; font-size:12pt; font-weight:700; margin:14px 0 6px; }
    .field-wrap { position:relative; margin-bottom:10px; }
    textarea.fb {
        display:block; width:100%; background:#d0cece; color:#1a7a1a;
        border:none; border-bottom:1.5px solid #999;
        font-family:'Calibri',Arial,sans-serif; font-size:11pt;
        line-height:1.4; padding:4px 6px; outline:none; resize:vertical; min-height:52px;
    }
    textarea.fb:focus { background:#bfbcbc; }
    textarea.fb::placeholder { color:#9a7ab5; font-style:italic; }
    textarea.fb.req-empty { border-bottom:2px solid #c00; background:#f5d0d0; }
    textarea.fb.cond { border-bottom-style:dashed; }
    /* Reporting table */
    .rpt-tbl { width:100%; border-collapse:collapse; margin:8px 0; font-size:9pt; table-layout:fixed; }
    .rpt-tbl th { background:#404040; color:#fff; font-family:Arial,sans-serif; font-weight:700; font-size:8.5pt; padding:4px 5px; text-align:left; border:1px solid #555; word-wrap:break-word; }
    .rpt-tbl td { border:1px solid #aaa; padding:2px 3px; vertical-align:top; }
    /* Buttons */
    .add-btn    { background:#00B050; color:#fff; border:none; border-radius:3px; padding:4px 12px; font-size:10pt; cursor:pointer; font-family:'Calibri',Arial,sans-serif; white-space:nowrap; }
    .add-btn:hover { background:#008a3e; }
    .popout-btn { background:#5a7abf; color:#fff; border:none; border-radius:3px; padding:4px 12px; font-size:10pt; cursor:pointer; font-family:'Calibri',Arial,sans-serif; white-space:nowrap; }
    .popout-btn:hover { background:#3d5a9e; }
    /* Popout */
    #s9-popout { display:none; position:fixed; inset:0; background:#fff; z-index:500; flex-direction:column; }
    .popout-hdr { background:#1f3864; color:#fff; padding:10px 18px; display:flex; align-items:center; justify-content:space-between; font-family:'Times New Roman',Times,serif; font-size:13pt; font-weight:700; }
    .popout-body { flex:1; overflow:auto; padding:18px 24px; }
    /* Toolbar */
    .toolbar { display:flex; justify-content:flex-end; gap:10px; margin-top:32px; flex-wrap:wrap; }
    .btn { padding:7px 20px; border:none; border-radius:3px; font-size:10pt; font-family:inherit; cursor:pointer; }
    .btn-primary   { background:#1f3864; color:#fff; } .btn-primary:hover { background:#162a4e; }
    .btn-secondary { background:#eee; color:#333; border:1px solid #ccc; } .btn-secondary:hover { background:#ddd; }
    /* Dialogs */
    .overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:200; align-items:center; justify-content:center; }
    .overlay.show { display:flex; }
    .dbox { background:#fff; border-radius:6px; padding:28px 32px; width:400px; box-shadow:0 8px 40px rgba(0,0,0,0.25); }
    .dbox h3 { font-size:13pt; font-weight:700; color:#1f3864; margin-bottom:12px; }
    .dbox p  { font-size:10.5pt; margin-bottom:16px; line-height:1.5; }
    .dbox input[type=text] { width:100%; border:1px solid #aaa; border-radius:3px; padding:6px 8px; font-size:10pt; margin-bottom:14px; outline:none; }
    .fmt-row { display:flex; gap:14px; margin-bottom:20px; }
    .fmt-row label { display:flex; align-items:center; gap:5px; font-size:10pt; cursor:pointer; }
    .dbr { display:flex; justify-content:flex-end; gap:10px; }
    .sbar { position:fixed; bottom:0; left:0; right:0; background:#1f3864; color:#fff; font-size:9pt; padding:5px 18px; display:flex; justify-content:space-between; align-items:center; z-index:100; }
    .err  { background:#fff3cd; color:#856404; border:1px solid #ffc107; padding:10px; margin-bottom:10px; border-radius:4px; font-size:10pt; }
    /* Context menu */
    .ctx-menu {
        display:none; position:fixed;
        background:#fff; border:1px solid #ccc; border-radius:4px;
        box-shadow:0 4px 16px rgba(0,0,0,0.18);
        z-index:1000; min-width:320px; max-width:420px;
        font-family:'Calibri',Arial,sans-serif; font-size:10pt;
    }
    .ctx-hdr {
        background:#1f3864; color:#fff; padding:8px 12px;
        font-weight:700; font-size:10pt; border-radius:4px 4px 0 0;
        display:flex; justify-content:space-between; align-items:center;
    }
    .ctx-close { background:none; border:none; color:#fff; font-size:14px; cursor:pointer; padding:0 2px; }
    .ctx-body  { padding:10px 12px; }
    .ctx-row   { display:flex; gap:8px; margin-bottom:6px; font-size:9.5pt; }
    .ctx-row label { font-weight:700; white-space:nowrap; min-width:100px; color:#333; }
    .ctx-row span  { color:#555; word-break:break-all; }
    .ctx-div   { border:none; border-top:1px solid #e0e0e0; margin:8px 0; }
    .ctx-guide { font-size:9.5pt; color:#444; line-height:1.5; }
    .ctx-guide strong { color:#1f3864; }
</style>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="err">⚠ @ErrorMessage</div>
}

<div class="doc-page">

    <div class="h1">9.&nbsp;&nbsp;Adverse Events, Serious Adverse Events, Product Complaints, Pregnancy and Postpartum Information, and Special Safety Situations</div>

    <!-- 9.1 Definitions -->
    <div class="h2">9.1&nbsp;&nbsp;Definitions</div>

    <div class="h3">9.1.1&nbsp;&nbsp;Definitions of Adverse Events</div>
    <div class="field-wrap">
        <textarea data-ctx="C218476" class="@ReqClass(Model.C218476)" rows="3"
            placeholder="Enter Definitions of Adverse Events"
            @bind="Model.C218476" @bind:event="oninput"></textarea>
    </div>

    <div class="h3">9.1.2&nbsp;&nbsp;Definitions of Serious Adverse Events</div>
    <div class="field-wrap">
        <textarea data-ctx="C218781" class="@ReqClass(Model.C218781)" rows="3"
            placeholder="Enter Definitions of Serious Adverse Events"
            @bind="Model.C218781" @bind:event="oninput"></textarea>
    </div>

    <div class="h3">9.1.3&nbsp;&nbsp;Definitions of Product Complaints</div>
    <div class="field-wrap">
        <textarea data-ctx="C218782" class="@ReqClass(Model.C218782)" rows="3"
            placeholder="Enter Definitions of Product Complaints"
            @bind="Model.C218782" @bind:event="oninput"></textarea>
    </div>

    <div class="h4p">9.1.3.1&nbsp;&nbsp;Definitions of Medical Device Product Complaints</div>
    <div class="field-wrap">
        <textarea data-ctx="C218783" class="fb" rows="3"
            placeholder="Enter Definitions of Medical Device Product Complaints"
            @bind="Model.C218783" @bind:event="oninput"></textarea>
    </div>

    <!-- 9.2 Timing and Procedures -->
    <div class="h2">9.2&nbsp;&nbsp;Timing and Procedures for Collection and Reporting</div>
    <p style="font-size:10.5pt;margin:0 0 8px;">This table describes the timing and procedures for collecting and reporting events.</p>

    <div class="h4">
        <button class="popout-btn" @onclick="OpenPopout">⤢ Pop-out</button>
        <button class="add-btn"    @onclick="AddRptRow">+ Add Row</button>
    </div>

    <table class="rpt-tbl" id="s9-rpt-table">
        <thead>
            <tr>
                <th style="width:13%">Event Type</th>
                <th style="width:12%">Situational Scope</th>
                <th style="width:12%">Reportable Period Start</th>
                <th style="width:12%">Reportable Period End</th>
                <th style="width:17%">Timing for Reporting to Sponsor or Designee</th>
                <th style="width:17%">Method for Reporting</th>
                <th style="width:17%">Back-up Method for Reporting</th>
            </tr>
        </thead>
        <tbody id="s9-rpt-tbody">
            @foreach (var row in RptRows)
            {
                <tr>
                    <td>
                        @foreach (var code in new[]{"C218784","C222263"})
                        {
                            var fid = $"{code}_r{row}";
                            <div class="field-wrap">
                                <textarea data-ctx="@fid"
                                    class="@(code == "C222263" ? "fb cond" : "fb")" rows="2"
                                    placeholder="@RptColPh(code)"
                                    value="@GetTbl(fid)"
                                    @oninput="@(e => SetTbl(fid, e.Value?.ToString()))"
                                    ></textarea>
                            </div>
                        }
                    </td>
                    @foreach (var code in new[]{"C218785","C218786","C218787","C218788","C218789","C218790"})
                    {
                        var fid = $"{code}_r{row}";
                        <td>
                            <div class="field-wrap">
                                <textarea data-ctx="@fid" class="fb" rows="2"
                                    placeholder="@RptColPh(code)"
                                    value="@GetTbl(fid)"
                                    @oninput="@(e => SetTbl(fid, e.Value?.ToString()))"
                                    ></textarea>
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    <div class="h3">9.2.1&nbsp;&nbsp;Timing</div>
    <div class="field-wrap">
        <textarea data-ctx="C218791" class="@ReqClass(Model.C218791)" rows="3"
            placeholder="Enter Event Collection and Reporting Timing"
            @bind="Model.C218791" @bind:event="oninput"></textarea>
    </div>

    <div class="h3">9.2.2&nbsp;&nbsp;Collection Procedures</div>

    <div class="h4p">Identification</div>
    <div class="field-wrap">
        <textarea data-ctx="C218792" class="@ReqClass(Model.C218792)" rows="3"
            placeholder="Enter Identification"
            @bind="Model.C218792" @bind:event="oninput"></textarea>
    </div>

    <div class="h4p">Severity</div>
    <div class="field-wrap">
        <textarea data-ctx="C25676" class="@ReqClass(Model.C25676)" rows="3"
            placeholder="Enter severity"
            @bind="Model.C25676" @bind:event="oninput"></textarea>
    </div>

    <div class="h4p">Causality</div>
    <div class="field-wrap">
        <textarea data-ctx="C82552" class="@ReqClass(Model.C82552)" rows="3"
            placeholder="Enter causality"
            @bind="Model.C82552" @bind:event="oninput"></textarea>
    </div>

    <div class="h4p">Recording</div>
    <div class="field-wrap">
        <textarea data-ctx="C218793" class="@ReqClass(Model.C218793)" rows="3"
            placeholder="Enter recording"
            @bind="Model.C218793" @bind:event="oninput"></textarea>
    </div>

    <div class="h4p">Follow-up</div>
    <div class="field-wrap">
        <textarea data-ctx="C218794" class="@ReqClass(Model.C218794)" rows="3"
            placeholder="Enter follow-up"
            @bind="Model.C218794" @bind:event="oninput"></textarea>
    </div>

    <div class="h3">9.2.3&nbsp;&nbsp;Reporting</div>
    <div class="field-wrap">
        <textarea data-ctx="C218795" class="@ReqClass(Model.C218795)" rows="3"
            placeholder="Specify the reporting method"
            @bind="Model.C218795" @bind:event="oninput"></textarea>
    </div>

    <div class="h4p">9.2.3.1&nbsp;&nbsp;Regulatory Reporting Requirements</div>
    <div class="field-wrap">
        <textarea data-ctx="C218796" class="@ReqClass(Model.C218796)" rows="3"
            placeholder="Specify Regulatory Reporting Requirements"
            @bind="Model.C218796" @bind:event="oninput"></textarea>
    </div>

    <div class="h3">9.2.4&nbsp;&nbsp;Adverse Events of Special Interest</div>
    <div class="field-wrap">
        <textarea data-ctx="C217358" class="@ReqClass(Model.C217358)" rows="3"
            placeholder="Adverse Events of Special Interest"
            @bind="Model.C217358" @bind:event="oninput"></textarea>
    </div>

    <div class="h3">9.2.5&nbsp;&nbsp;Disease-related Events or Outcomes Not Qualifying as AEs or SAEs</div>
    <div class="field-wrap">
        <textarea data-ctx="C218797" class="@ReqClass(Model.C218797)" rows="3"
            placeholder="Specify any Disease-related Events or Outcomes Not Qualifying as AEs or SAEs"
            @bind="Model.C218797" @bind:event="oninput"></textarea>
    </div>

    <!-- 9.3 Pregnancy -->
    <div class="h2">9.3&nbsp;&nbsp;Pregnancy and Postpartum Information</div>

    <div class="h3">9.3.1&nbsp;&nbsp;Participants Who Become Pregnant During the Trial</div>
    <div class="field-wrap">
        <textarea data-ctx="C218798" class="fb" rows="3"
            placeholder="Specify Participants Who Become Pregnant During the Trial"
            @bind="Model.C218798" @bind:event="oninput"></textarea>
    </div>

    <div class="h3">9.3.2&nbsp;&nbsp;Participants Whose Partners Become Pregnant During the Trial</div>
    <div class="field-wrap">
        <textarea data-ctx="C218799" class="fb" rows="3"
            placeholder="Specify Participants Whose Partners Become Pregnant During the Trial"
            @bind="Model.C218799" @bind:event="oninput"></textarea>
    </div>

    <!-- 9.4 Special Safety -->
    <div class="h2">9.4&nbsp;&nbsp;Special Safety Situations</div>
    <div class="field-wrap">
        <textarea data-ctx="C218800" class="@ReqClass(Model.C218800)" rows="3"
            placeholder="Special Safety Situations"
            @bind="Model.C218800" @bind:event="oninput"></textarea>
    </div>

    <div class="toolbar">
        <button class="btn btn-secondary" @onclick="ClearAll">Clear All</button>
        <button class="btn btn-secondary" @onclick="LoadSample">Load Sample</button>
        <button class="btn btn-secondary" @onclick="OpenSaveDialog">⬇ Save to File…</button>
        <button class="btn btn-secondary" @onclick="OpenLoadDialog">⬆ Load from File</button>
        <button class="btn btn-primary"   @onclick="SaveToBrowser">Save to Browser</button>
    </div>
</div>

<!-- Popout -->
<div id="s9-popout">
    <div class="popout-hdr">
        <span>Timing and Procedures for Collection and Reporting</span>
        <div style="display:flex;gap:10px;align-items:center;">
            <button class="add-btn"    @onclick="AddRptRow">+ Add Row</button>
            <button class="btn btn-secondary" @onclick="ClosePopout" style="padding:4px 14px;">✕ Close</button>
        </div>
    </div>
    <div class="popout-body">
        <table class="rpt-tbl">
            <thead>
                <tr>
                    <th style="width:13%">Event Type</th>
                    <th style="width:12%">Situational Scope</th>
                    <th style="width:12%">Reportable Period Start</th>
                    <th style="width:12%">Reportable Period End</th>
                    <th style="width:17%">Timing for Reporting to Sponsor or Designee</th>
                    <th style="width:17%">Method for Reporting</th>
                    <th style="width:17%">Back-up Method for Reporting</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in RptRows)
                {
                    <tr>
                        <td>
                            @foreach (var code in new[]{"C218784","C222263"})
                            {
                                var fid = $"{code}_r{row}";
                                <div class="field-wrap">
                                    <textarea data-ctx="@fid" class="@(code == "C222263" ? "fb cond" : "fb")" rows="2"
                                        placeholder="@RptColPh(code)"
                                        value="@GetTbl(fid)"
                                        @oninput="@(e => SetTbl(fid, e.Value?.ToString()))"
                                        ></textarea>
                                </div>
                            }
                        </td>
                        @foreach (var code in new[]{"C218785","C218786","C218787","C218788","C218789","C218790"})
                        {
                            var fid = $"{code}_r{row}";
                            <td>
                                <div class="field-wrap">
                                    <textarea data-ctx="@fid" class="fb" rows="2"
                                        placeholder="@RptColPh(code)"
                                        value="@GetTbl(fid)"
                                        @oninput="@(e => SetTbl(fid, e.Value?.ToString()))"
                                        ></textarea>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        <p style="font-size:9pt;color:#555;margin-top:8px;">Changes here are reflected on the main page.</p>
    </div>
</div>

<!-- Save dialog -->
<div class="overlay @SaveDialogCss">
    <div class="dbox">
        <h3>Save Data to File</h3>
        <label style="display:block;font-weight:700;margin-bottom:6px;">File name</label>
        <input type="text" @bind="SaveFileName" @bind:event="oninput" />
        <label style="display:block;font-weight:700;margin:10px 0 6px;">Format</label>
        <div class="fmt-row">
            <label><input type="radio" name="s9fmt" checked="@IsJson" @onchange="SetFmtJson" /> JSON</label>
            <label><input type="radio" name="s9fmt" checked="@IsCsv"  @onchange="SetFmtCsv"  /> CSV</label>
            <label><input type="radio" name="s9fmt" checked="@IsTxt"  @onchange="SetFmtTxt"  /> Plain Text</label>
            <label><input type="radio" name="s9fmt" checked="@IsFhir" @onchange="SetFmtFhir" /> FHIR</label>
        </div>
        <div class="dbr">
            <button class="btn btn-secondary" @onclick="CloseSaveDialog">Cancel</button>
            <button class="btn btn-primary"   @onclick="DoSaveToFile">Download</button>
        </div>
    </div>
</div>

<!-- Required fields dialog -->
<div class="overlay @ReqDialogCss">
    <div class="dbox">
        <h3 style="color:#c00;">Incomplete Required Fields</h3>
        <p>@ReqDialogMsg</p>
        <div class="dbr">
            <button class="btn btn-secondary" @onclick="CloseReqDialog">Cancel</button>
            <button class="btn btn-primary" style="background:#c00;" @onclick="ForceConfirm">Save Anyway</button>
        </div>
    </div>
</div>

<!-- Context menu -->
<div id="s9-ctx-menu" class="ctx-menu">
    <div class="ctx-hdr">
        <span>Field Information</span>
        <button class="ctx-close" @onclick="CloseCtxMenu">✕</button>
    </div>
    <div class="ctx-body">
        <div class="ctx-row">
            <label>Field name:</label>
            <span>@CtxFieldName</span>
        </div>
        <div class="ctx-row">
            <label>Original name:</label>
            <span>@CtxOriginalName</span>
        </div>
        <hr class="ctx-div" />
        <div class="ctx-guide">
            <strong>Guidance:</strong><br />
            @CtxGuidance
        </div>
    </div>
</div>

<div class="sbar">
    <span>Section 9 – Data Entry &nbsp;|&nbsp; Grey = data entry &nbsp;|&nbsp; Red border = required &nbsp;|&nbsp; Dashed = conditional</span>
    <span>@StatusMessage</span>
</div>

@code {
    private Section09Model Model    = new();
    private List<int>       RptRows = new() { 1 };
    private int             NextRow = 2;

    private bool   ShowValidation = false;
    private bool   ShowSaveDialog = false;
    private bool   ShowReqDialog  = false;
    private string SaveFileName   = "section9_data";
    private string SaveFormat     = "json";
    private string StatusMessage  = string.Empty;
    private string ReqDialogMsg   = string.Empty;
    private string ErrorMessage   = string.Empty;
    private string? PendingAction = null;

    private System.Threading.Timer?           _statusTimer;
    private bool _reinitCtxMenus = false;

    // ── Context menu ──────────────────────────────────────────────
    private string CtxFieldName    = string.Empty;
    private string CtxOriginalName = string.Empty;
    private string CtxGuidance     = string.Empty;
    private DotNetObjectReference<Section09>? _objRef;

    // ── CSS helpers ───────────────────────────────────────────────
    private string SaveDialogCss => ShowSaveDialog ? "overlay show" : "overlay";
    private string ReqDialogCss  => ShowReqDialog  ? "overlay show" : "overlay";
    private bool IsJson => SaveFormat == "json";
    private bool IsCsv  => SaveFormat == "csv";
    private bool IsTxt  => SaveFormat == "txt";
    private bool IsFhir => SaveFormat == "fhir";
    private void SetFmtJson(ChangeEventArgs e) => SaveFormat = "json";
    private void SetFmtCsv(ChangeEventArgs e)  => SaveFormat = "csv";
    private void SetFmtTxt(ChangeEventArgs e)  => SaveFormat = "txt";
    private void SetFmtFhir(ChangeEventArgs e) => SaveFormat = "fhir";

    private string ReqClass(string? val) =>
        ShowValidation && string.IsNullOrWhiteSpace(val) ? "fb req-empty" : "fb";

    // ── Reporting table ───────────────────────────────────────────
    private string GetTbl(string key) =>
        Model.RptTableData.TryGetValue(key, out var v) ? v : string.Empty;

    private void SetTbl(string key, string? value)
    {
        Model.RptTableData[key] = value ?? string.Empty;
        AutoSave();
    }

    private void AutoSave()
    {
        _ = JS.InvokeVoidAsync("localStorage.setItem", "s9data", DataSvc.ToJson(Model));
    }

    private void AddRptRow()
    {
        RptRows.Add(NextRow++);
        Model.RptRows = RptRows.Count;
        _reinitCtxMenus = true;
        AutoSave();
    }

    private static string RptColPh(string code) => code switch
    {
        "C218784" => "Select Event type",
        "C222263" => "Enter other event type",
        "C218785" => "Enter Situational Scope",
        "C218786" => "Enter Reportable Period Start",
        "C218787" => "Enter Reportable Period End",
        "C218788" => "Enter Timing for Reporting to Sponsor or Designee",
        "C218789" => "Enter Method for Reporting",
        "C218790" => "Enter Back-up Method for Reporting",
        _         => string.Empty
    };

    // ── Popout ────────────────────────────────────────────────────
    private async Task OpenPopout()  => await JS.InvokeVoidAsync("s9ShowPopout");
    private async Task ClosePopout() => await JS.InvokeVoidAsync("s9HidePopout");

    // ── Validation ────────────────────────────────────────────────
    private bool HasRequiredEmpty() =>
        string.IsNullOrWhiteSpace(Model.C218476) ||
        string.IsNullOrWhiteSpace(Model.C218781) ||
        string.IsNullOrWhiteSpace(Model.C218782) ||
        string.IsNullOrWhiteSpace(Model.C218791) ||
        string.IsNullOrWhiteSpace(Model.C218792) ||
        string.IsNullOrWhiteSpace(Model.C25676)  ||
        string.IsNullOrWhiteSpace(Model.C82552)  ||
        string.IsNullOrWhiteSpace(Model.C218793) ||
        string.IsNullOrWhiteSpace(Model.C218794) ||
        string.IsNullOrWhiteSpace(Model.C218795) ||
        string.IsNullOrWhiteSpace(Model.C218796) ||
        string.IsNullOrWhiteSpace(Model.C217358) ||
        string.IsNullOrWhiteSpace(Model.C218797) ||
        string.IsNullOrWhiteSpace(Model.C218800);

    private int RequiredEmptyCount()
    {
        var props = new[]
        {
            Model.C218476, Model.C218781, Model.C218782,
            Model.C218791, Model.C218792, Model.C25676,
            Model.C82552,  Model.C218793, Model.C218794,
            Model.C218795, Model.C218796, Model.C217358,
            Model.C218797, Model.C218800
        };
        return props.Count(string.IsNullOrWhiteSpace);
    }

    // ── Clear ─────────────────────────────────────────────────────
    private void ClearAll()
    {
        Model          = new Section09Model();
        RptRows        = new List<int> { 1 };
        NextRow        = 2;
        ShowValidation = false;
        ErrorMessage   = string.Empty;
        SetStatus("Cleared");
    }

    // ── Load Sample ───────────────────────────────────────────────
    private void LoadSample()
    {
        var sample = DataSvc.LoadSample();
        if (sample != null)
        {
            Model          = sample;
            RptRows        = Enumerable.Range(1, Math.Max(1, sample.RptRows)).ToList();
            NextRow        = RptRows.Count + 1;
            ShowValidation = false;
            _reinitCtxMenus = true;
            SetStatus("Sample data loaded");
        }
        else
        {
            ErrorMessage = "Could not load sample file.";
        }
    }

    // ── Save to Browser ───────────────────────────────────────────
    private async Task SaveToBrowser()
    {
        ShowValidation = true;
        if (HasRequiredEmpty())
        {
            ReqDialogMsg  = $"{RequiredEmptyCount()} required field(s) are empty. Do you still want to save?";
            PendingAction = "browser";
            ShowReqDialog = true;
            return;
        }
        await DoBrowserSave();
    }

    private async Task DoBrowserSave()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "s9data", DataSvc.ToJson(Model));
            SetStatus("✓ Saved " + DateTime.Now.ToShortTimeString());
        }
        catch (Exception ex) { ErrorMessage = "Save error: " + ex.Message; }
    }

    // ── Save dialog ───────────────────────────────────────────────
    private void OpenSaveDialog()
    {
        ShowValidation = true;
        if (HasRequiredEmpty())
        {
            ReqDialogMsg  = $"{RequiredEmptyCount()} required field(s) are empty. Do you still want to save?";
            PendingAction = "file";
            ShowReqDialog = true;
            return;
        }
        SaveFileName   = "section9_data_" + DateTime.Now.ToString("yyyy-MM-dd");
        ShowSaveDialog = true;
    }

    private void CloseSaveDialog() => ShowSaveDialog = false;
    private void CloseReqDialog()  { ShowReqDialog = false; PendingAction = null; }

    private async Task ForceConfirm()
    {
        ShowReqDialog = false;
        if (PendingAction == "browser") await DoBrowserSave();
        else if (PendingAction == "file")
        {
            SaveFileName   = "section9_data_" + DateTime.Now.ToString("yyyy-MM-dd");
            ShowSaveDialog = true;
        }
        PendingAction = null;
    }

    private async Task DoSaveToFile()
    {
        ShowSaveDialog = false;
        var (content, mime, ext) = SaveFormat switch
        {
            "csv"  => (DataSvc.ToCsv(Model),       "text/csv",         ".csv"),
            "txt"  => (DataSvc.ToPlainText(Model),  "text/plain",       ".txt"),
            "fhir" => (DataSvc.ToFsh(Model),        "text/plain",       ".fsh"),
            _      => (DataSvc.ToJson(Model),       "application/json", ".json"),
        };
        var fn = (SaveFileName.Trim().Length > 0 ? SaveFileName.Trim() : "section9_data") + ext;
        await JS.InvokeVoidAsync("udpDownload", fn, content, mime);
        SetStatus("⬇ Downloaded " + fn);
    }

