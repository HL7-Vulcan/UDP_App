            ShowValidation = false;
            SetStatus("⬆ Loaded from file");
            InvokeAsync(StateHasChanged);
        }
    }

    // ── Init ──────────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (_reinitCtxMenus)
            {
                _reinitCtxMenus = false;
                await JS.InvokeVoidAsync("udpInitContextMenus", "s9-ctx-menu");
            }
            return;
        }
        try
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("udpSetDotNetRef", _objRef);
            await JS.InvokeVoidAsync("udpInitContextMenus", "s9-ctx-menu");
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "s9data");
            if (!string.IsNullOrEmpty(json))
            {
                var loaded = DataSvc.FromJson(json);
                if (loaded != null)
                {
                    Model   = loaded;
                    RptRows = Enumerable.Range(1, Math.Max(1, loaded.RptRows)).ToList();
                    NextRow = RptRows.Count + 1;
                    StateHasChanged();
                }
            }
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException)   { }
        catch (Exception ex) { ErrorMessage = "Init error: " + ex.Message; StateHasChanged(); }
    }

    // ── Status ────────────────────────────────────────────────────
    private void SetStatus(string msg)
    {
        StatusMessage = msg;
        _statusTimer?.Dispose();
        _statusTimer = new System.Threading.Timer(_ =>
        {
            StatusMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        }, null, 4000, System.Threading.Timeout.Infinite);
    }

    public void Dispose() { _objRef?.Dispose(); _statusTimer?.Dispose(); }
}
