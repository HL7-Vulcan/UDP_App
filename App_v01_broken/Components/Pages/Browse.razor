@page "/browse"
@rendermode InteractiveServer
@implements IDisposable
@using UDP_App.Models
@using UDP_App.Services
@inject FhirBrowseService FhirSvc
@inject SettingsService SettingsSvc
@inject IJSRuntime JS

<PageTitle>Browse Resources — UDP Browse</PageTitle>

<h1>Browse FHIR Resources</h1>
<p class="text-muted">Server: <code>@SettingsSvc.Settings.BaseUrl</code></p>

@if (_loadingTypes)
{
    <p><em>Loading resource types…</em></p>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
    <button class="btn btn-secondary" @onclick="LoadResourceTypes">Retry</button>
}
else
{
    <div class="row">
        <!-- Resource type list with counts -->
        <div class="col-md-4" style="max-height:80vh; overflow-y:auto;">

            @if (_loadingCounts)
            {
                <p class="text-muted" style="font-size:0.85em;">Loading counts…</p>
            }

            @{
                var withData   = _resourceTypes.Where(t => _counts.TryGetValue(t, out var c) && c.HasValue && c.Value > 0).ToList();
                var nullCount  = _resourceTypes.Where(t => _counts.TryGetValue(t, out var c) && !c.HasValue).ToList();
                var zeroCount  = _resourceTypes.Where(t => _counts.TryGetValue(t, out var c) && c.HasValue && c.Value == 0).ToList();
                var pending    = _resourceTypes.Where(t => !_counts.ContainsKey(t)).ToList();
            }

            <!-- Section 1: resources with data -->
            @if (withData.Count > 0 || pending.Count > 0)
            {
                <h6 class="mt-2 mb-1 text-secondary" style="font-size:0.8em; text-transform:uppercase; letter-spacing:0.05em;">
                    With Data (@withData.Count)
                </h6>
                <div class="list-group mb-3">
                    @foreach (var type in withData)
                    {
                        @ResourceButton(type)
                    }
                    @foreach (var type in pending)
                    {
                        @ResourceButton(type)
                    }
                </div>
            }

            <!-- Section 2: null / unavailable (collapsed) -->
            @if (nullCount.Count > 0)
            {
                <details class="mb-2">
                    <summary class="text-muted" style="font-size:0.85em; cursor:pointer; user-select:none;">
                        Count unavailable (@nullCount.Count)
                    </summary>
                    <div class="list-group mt-1">
                        @foreach (var type in nullCount)
                        {
                            @ResourceButton(type)
                        }
                    </div>
                </details>
            }

            <!-- Section 3: zero instances (collapsed) -->
            @if (zeroCount.Count > 0)
            {
                <details class="mb-2">
                    <summary class="text-muted" style="font-size:0.85em; cursor:pointer; user-select:none;">
                        Empty (0 instances) (@zeroCount.Count)
                    </summary>
                    <div class="list-group mt-1">
                        @foreach (var type in zeroCount)
                        {
                            @ResourceButton(type)
                        }
                    </div>
                </details>
            }

        </div>

        <!-- Resource detail list -->
        <div class="col-md-8">
            @if (_selectedType is null)
            {
                <p class="text-muted">Select a resource type on the left.</p>
            }
            else if (_loadingResources)
            {
                <div class="d-flex align-items-center gap-2 my-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Loading…</span>
                    </div>
                    <span class="text-muted">Loading @_selectedType resources…</span>
                </div>
            }
            else
            {
                <h5>
                    @_selectedType
                    @if (_counts.TryGetValue(_selectedType, out var total) && total.HasValue)
                    {
                        <span class="badge bg-secondary ms-1">@total.Value.ToString("N0") total</span>
                    }
                    <span class="badge bg-light text-dark ms-1">@_resources.Count shown</span>
                </h5>

                @if (_resources.Count == 0)
                {
                    <p class="text-muted">No resources found.</p>
                }
                else
                {
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Display</th>
                                <th>Last Updated</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _resources)
                            {
                                <tr>
                                    <td><code>@r.Id</code></td>
                                    <td>@(r.Display ?? "—")</td>
                                    <td>@(r.LastUpdated ?? "—")</td>
                                    <td class="text-end text-nowrap">
                                        <button class="btn btn-outline-secondary btn-sm me-1"
                                                @onclick="() => OpenJson(r.ResourceType, r.Id)"
                                                disabled="@(_jsonLoading == r.Id)">
                                            @if (_jsonLoading == r.Id)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                            }
                                            else
                                            {
                                                <span>JSON</span>
                                            }
                                        </button>
                                        <a class="btn btn-outline-primary btn-sm"
                                           href="@BuildVhewerUrl(r.ResourceType, r.Id)"
                                           target="_blank" rel="noopener noreferrer">
                                            Vhewer
                                        </a>
                                        @if (r.ResourceType == "Bundle")
                                        {
                                            <a class="btn btn-outline-success btn-sm ms-1"
                                               href="@BuildStudyUrl(r.ResourceType, r.Id)"
                                               target="_blank" rel="noopener noreferrer">
                                                Study
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex gap-2 mt-2">
                        @if (_prevUrls.Count > 0)
                        {
                            <button class="btn btn-outline-secondary btn-sm" @onclick="PrevPage">← Previous</button>
                        }
                        @if (_nextUrl is not null)
                        {
                            <button class="btn btn-outline-primary btn-sm" @onclick="NextPage">Next →</button>
                        }
                    </div>
                }
            }

            <!-- JSON panel -->
            @if (_jsonPanel is not null)
            {
                <div class="mt-3 border rounded" style="background:#f8f9fa;">
                    <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                        <strong style="font-size:0.9em;">@_jsonPanel.ResourceType / @_jsonPanel.Id</strong>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-secondary"
                                    @onclick="DownloadJson">
                                ⬇ JSON
                            </button>
                            <button class="btn btn-sm btn-close" @onclick="() => _jsonPanel = null"></button>
                        </div>
                    </div>
                    <pre style="max-height:40vh; overflow:auto; font-size:0.78em; padding:1rem; margin:0;">@_jsonPanel.Json</pre>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<string> _resourceTypes = new();
    private Dictionary<string, int?> _counts = new();
    private string? _selectedType;
    private bool _loadingCounts;

    private RenderFragment ResourceButton(string type) => __builder =>
    {
        <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(type == _selectedType ? "active" : "")"
                @onclick="() => SelectType(type)">
            <span>@type</span>
            @if (_counts.TryGetValue(type, out var count))
            {
                <span class="badge @(type == _selectedType ? "bg-light text-dark" : "bg-secondary") rounded-pill">
                    @(count.HasValue ? count.Value.ToString("N0") : "—")
                </span>
            }
            else
            {
                <span class="badge bg-light text-muted rounded-pill" style="font-size:0.7em;">…</span>
            }
        </button>
    };
    private List<FhirResourceSummary> _resources = new();

    private bool _loadingTypes = true;
    private bool _loadingResources;
    private string? _errorMessage;
    private string? _jsonLoading;  // id of resource currently being fetched for JSON panel
    private JsonPanelModel? _jsonPanel;

    private record JsonPanelModel(string ResourceType, string Id, string Json);

    private string? _nextUrl;
    private Stack<string?> _prevUrls = new();
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync() => await LoadResourceTypes();

    public void Dispose() => _cts.Cancel();

    private async Task LoadResourceTypes()
    {
        _loadingTypes = true;
        _errorMessage = null;
        _counts.Clear();
        try
        {
            _resourceTypes = await FhirSvc.GetResourceTypesAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not reach server: {ex.Message}";
            return;
        }
        finally
        {
            _loadingTypes = false;
        }

        // Load counts sequentially to avoid scoped-service concurrency issues
        _loadingCounts = true;
        foreach (var type in _resourceTypes)
        {
            if (_cts.IsCancellationRequested) break;
            _counts[type] = await FhirSvc.GetResourceCountAsync(type);
            StateHasChanged();
        }
        _loadingCounts = false;
    }

    private async Task SelectType(string type)
    {
        _selectedType = type;
        _prevUrls.Clear();
        _nextUrl = null;
        await LoadPage(null);
    }

    private async Task NextPage()
    {
        _prevUrls.Push(GetCurrentUrl());
        await LoadPage(_nextUrl);
    }

    private async Task PrevPage()
    {
        var url = _prevUrls.Count > 1 ? _prevUrls.Pop() : null;
        await LoadPage(url);
    }

    private string? GetCurrentUrl() =>
        _selectedType is null ? null
            : $"{SettingsSvc.Settings.BaseUrl}/{_selectedType}?_count=20&_summary=true&_sort=-_lastUpdated";

    private async Task DownloadJson()
    {
        if (_jsonPanel is null) return;
        await DownloadFile(_jsonPanel.Json,
            $"{_jsonPanel.ResourceType}-{_jsonPanel.Id}.json",
            "application/json");
    }

    private async Task OpenJson(string resourceType, string id)
    {
        _jsonLoading = id;
        _jsonPanel   = null;
        var json = await FhirSvc.GetResourceJsonAsync(resourceType, id);
        _jsonPanel   = json is not null ? new JsonPanelModel(resourceType, id, json) : null;
        _jsonLoading = null;
    }

    private async Task DownloadFile(string content, string filename, string mimeType)
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(content);
        var b64   = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadBase64File", filename, mimeType, b64);
    }

    private string BuildVhewerUrl(string resourceType, string id)
    {
        var s          = SettingsSvc.Settings;
        var vhewerBase = s.VhewerUrl.TrimEnd('/');
        var fhirBase   = s.BaseUrl.TrimEnd('/');
        return $"{vhewerBase}/?url={fhirBase}/{resourceType}/{id}/?_user={Uri.EscapeDataString(s.Username)}&_password={Uri.EscapeDataString(s.Password)}";
    }

    private string BuildStudyUrl(string resourceType, string id)
    {
        var s           = SettingsSvc.Settings;
        var vhewerBase  = s.VhewerUrl.TrimEnd('/');
        var fhirBase    = s.BaseUrl.TrimEnd('/');
        var studyOption = s.StudyOption.Trim('/');
        return $"{vhewerBase}/{studyOption}/?url={fhirBase}/{resourceType}/{id}/?_user={Uri.EscapeDataString(s.Username)}&_password={Uri.EscapeDataString(s.Password)}";
    }

    private async Task LoadPage(string? pageUrl)
    {
        if (_selectedType is null) return;
        _loadingResources = true;
        _errorMessage = null;
        try
        {
            var (resources, next) = await FhirSvc.GetResourcesAsync(_selectedType, pageUrl);
            _resources = resources;
            _nextUrl   = next;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading {_selectedType}: {ex.Message}";
        }
        finally
        {
            _loadingResources = false;
        }
    }
}
