@page "/section-02"
@layout MainLayout
@using Section_02.Models
@using Section_02.Services
@inject DataService DataSvc
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Section 2 – Introduction</PageTitle>

<style>
    .doc-page {
        background:#fff; width:794px; min-height:1123px;
        margin:30px auto 80px; padding:72px;
        box-shadow:0 4px 24px rgba(0,0,0,0.18);
        font-family:'Calibri',Arial,sans-serif; font-size:11pt; color:#000;
    }
    .h1 { font-family:'Times New Roman',Times,serif; font-size:14pt; font-weight:700; margin:0 0 18px; }
    .h2 { font-family:'Times New Roman',Times,serif; font-size:14pt; font-weight:700; margin:24px 0 10px; }
    .h3 { font-family:'Times New Roman',Times,serif; font-size:12pt; font-weight:700; margin:18px 0 8px; }
    .h4 { font-family:'Times New Roman',Times,serif; font-size:12pt; font-weight:700; margin:14px 0 6px; }
    .field-wrap { position:relative; margin-bottom:10px; }

    textarea.fb {
        display:block; width:100%; background:#d0cece; color:#1a7a1a;
        border:none; border-bottom:1.5px solid #999;
        font-family:'Calibri',Arial,sans-serif; font-size:11pt;
        line-height:1.4; padding:4px 6px; outline:none; resize:vertical; min-height:60px;
    }
    textarea.fb:focus { background:#bfbcbc; }
    textarea.fb::placeholder { color:#9a7ab5; font-style:italic; }
    textarea.fb.req-empty { border-bottom:2px solid #c00; background:#f5d0d0; }

    /* Context menu */
    .ctx-menu {
        display:none; position:fixed;
        background:#fff; border:1px solid #ccc; border-radius:4px;
        box-shadow:0 4px 16px rgba(0,0,0,0.18);
        z-index:1000; min-width:320px; max-width:420px;
        font-family:'Calibri',Arial,sans-serif; font-size:10pt;
    }
    .ctx-menu.open { display:block; }
    .ctx-header {
        background:#1f3864; color:#fff;
        padding:8px 12px; font-weight:700; font-size:10pt;
        border-radius:4px 4px 0 0;
        display:flex; justify-content:space-between; align-items:center;
    }
    .ctx-close {
        background:none; border:none; color:#fff;
        font-size:14px; cursor:pointer; padding:0 2px; line-height:1;
    }
    .ctx-body { padding:10px 12px; }
    .ctx-row { display:flex; gap:8px; margin-bottom:6px; font-size:9.5pt; }
    .ctx-row label { font-weight:700; white-space:nowrap; min-width:100px; color:#333; }
    .ctx-row span  { color:#555; word-break:break-all; }
    .ctx-divider   { border:none; border-top:1px solid #e0e0e0; margin:8px 0; }
    .ctx-guidance  { font-size:9.5pt; color:#444; line-height:1.5; }
    .ctx-guidance strong { color:#1f3864; }
    .toolbar { display:flex; justify-content:flex-end; gap:10px; margin-top:32px; flex-wrap:wrap; }
    .btn { padding:7px 20px; border:none; border-radius:3px; font-size:10pt; cursor:pointer; font-family:inherit; }
    .btn-primary   { background:#1f3864; color:#fff; }
    .btn-secondary { background:#eee; color:#333; border:1px solid #ccc; }
    .btn-danger    { background:#c00; color:#fff; }
    .fmt-row { display:flex; gap:14px; margin:10px 0 16px; }
    .fmt-row label { display:flex; align-items:center; gap:5px; font-size:10pt; cursor:pointer; }
    .overlay {
        display:none; position:fixed; inset:0;
        background:rgba(0,0,0,0.45); z-index:200;
        align-items:center; justify-content:center;
    }
    .overlay.show { display:flex; }
    .dbox { background:#fff; border-radius:6px; padding:28px 32px; width:400px; box-shadow:0 8px 40px rgba(0,0,0,0.25); }
    .dbox h3 { font-size:13pt; font-weight:700; color:#1f3864; margin-bottom:12px; }
    .dbox p  { font-size:10.5pt; margin-bottom:16px; line-height:1.5; }
    .dbox input[type=text] { width:100%; border:1px solid #aaa; border-radius:3px; padding:6px 8px; font-size:10pt; margin-bottom:14px; outline:none; }
    .dbr { display:flex; justify-content:flex-end; gap:10px; }
    .sbar {
        position:fixed; bottom:0; left:0; right:0;
        background:#1f3864; color:#fff; font-size:9pt;
        padding:5px 18px; display:flex; justify-content:space-between; align-items:center; z-index:100;
    }
    .err { background:#fff3cd; color:#856404; border:1px solid #ffc107; padding:10px; margin-bottom:10px; border-radius:4px; font-size:10pt; }
</style>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="err">⚠ @ErrorMessage</div>
}

<div class="doc-page">

    <div class="h1">2.&nbsp;&nbsp;Introduction</div>

    <div class="h2">2.1&nbsp;&nbsp;Purpose of Trial</div>
    <div class="field-wrap">
        <textarea title="C146997" data-ctx="C146997" class="@C146997Class" rows="4"
            placeholder="Hic textus tantummodo locum tenens est. Nullum verum sensum habet praeter spatium in pagina vel velo implere. Utile tamen est ad rem illustrandam. Huiusmodi ineptiae plerumque cum &quot;lorem ipsum&quot; incipiunt, sed ita translatae non sunt textus laetus."
            @bind="Model.C146997" @bind:event="oninput"></textarea>
    </div>

    <div class="h2">2.2&nbsp;&nbsp;Assessment of Risks and Benefits</div>
    <div class="h3">2.2.1&nbsp;&nbsp;Risk Summary and Mitigation Strategy</div>

    <div class="h4">Trial Intervention</div>
    <div class="field-wrap">
        <textarea title="C218721" data-ctx="C218721" class="fb" rows="4"
            placeholder="Hic textus tantummodo locum tenens est. Nullum verum sensum habet praeter spatium in pagina vel velo implere. Utile tamen est ad rem illustrandam. Huiusmodi ineptiae plerumque cum &quot;lorem ipsum&quot; incipiunt, sed ita translatae non sunt textus laetus."
            @bind="Model.C218721" @bind:event="oninput"></textarea>
    </div>

    <div class="h4">Trial Procedures</div>
    <div class="field-wrap">
        <textarea title="C218722" data-ctx="C218722" class="fb" rows="4"
            placeholder="Hic textus tantummodo locum tenens est. Nullum verum sensum habet praeter spatium in pagina vel velo implere. Utile tamen est ad rem illustrandam. Huiusmodi ineptiae plerumque cum &quot;lorem ipsum&quot; incipiunt, sed ita translatae non sunt textus laetus."
            @bind="Model.C218722" @bind:event="oninput"></textarea>
    </div>

    <div class="h4">Other</div>
    <div class="field-wrap">
        <textarea title="C218723" data-ctx="C218723" class="fb" rows="4"
            placeholder="Hic textus tantummodo locum tenens est. Nullum verum sensum habet praeter spatium in pagina vel velo implere. Utile tamen est ad rem illustrandam. Huiusmodi ineptiae plerumque cum &quot;lorem ipsum&quot; incipiunt, sed ita translatae non sunt textus laetus."
            @bind="Model.C218723" @bind:event="oninput"></textarea>
    </div>

    <div class="h3">2.2.2&nbsp;&nbsp;Benefit Summary</div>
    <div class="field-wrap">
        <textarea title="C218724" data-ctx="C218724" class="fb" rows="4"
            placeholder="Hic textus tantummodo locum tenens est. Nullum verum sensum habet praeter spatium in pagina vel velo implere. Utile tamen est ad rem illustrandam. Huiusmodi ineptiae plerumque cum &quot;lorem ipsum&quot; incipiunt, sed ita translatae non sunt textus laetus."
            @bind="Model.C218724" @bind:event="oninput"></textarea>
    </div>

    <div class="h3">2.2.3&nbsp;&nbsp;Overall Risk-Benefit Assessment</div>
    <div class="field-wrap">
        <textarea title="C218725" data-ctx="C218725" class="fb" rows="4"
            placeholder="Hic textus tantummodo locum tenens est. Nullum verum sensum habet praeter spatium in pagina vel velo implere. Utile tamen est ad rem illustrandam. Huiusmodi ineptiae plerumque cum &quot;lorem ipsum&quot; incipiunt, sed ita translatae non sunt textus laetus."
            @bind="Model.C218725" @bind:event="oninput"></textarea>
    </div>

    <div class="toolbar">
        <button class="btn btn-secondary" @onclick="ClearAll">Clear All</button>
        <button class="btn btn-secondary" @onclick="LoadSample">Load Sample</button>
        <button class="btn btn-secondary" @onclick="OpenSaveDialog">⬇ Save to File…</button>
        <button class="btn btn-secondary" @onclick="OpenLoadDialog">⬆ Load from File</button>
        <button class="btn btn-primary"   @onclick="SaveToBrowser">Save to Browser</button>
    </div>
</div>

<!-- Save dialog -->
<div class="overlay @SaveDialogCss">
    <div class="dbox">
        <h3>Save Data to File</h3>
        <label style="display:block;font-weight:700;margin-bottom:6px;">File name</label>
        <input type="text" @bind="SaveFileName" @bind:event="oninput" />
        <label style="display:block;font-weight:700;margin:10px 0 6px;">Format</label>
        <div class="fmt-row">
            <label><input type="radio" name="fmt" value="fhir" checked="@IsFhir" @onchange="SetFormatFhir" /> FHIR</label>
            <label><input type="radio" name="fmt" value="json" checked="@IsJson" @onchange="SetFormatJson" /> JSON</label>
            <label><input type="radio" name="fmt" value="csv"  checked="@IsCsv"  @onchange="SetFormatCsv"  /> CSV</label>
            <label><input type="radio" name="fmt" value="txt"  checked="@IsTxt"  @onchange="SetFormatTxt"  /> Plain Text</label>
        </div>
        <div class="dbr">
            <button class="btn btn-secondary" @onclick="CloseSaveDialog">Cancel</button>
            <button class="btn btn-primary"   @onclick="DoSaveToFile">Save</button>
        </div>
    </div>
</div>

<!-- Required fields dialog -->
<div class="overlay @ReqDialogCss">
    <div class="dbox">
        <h3 style="color:#c00;">Incomplete Required Fields</h3>
        <p>@ReqDialogMessage</p>
        <div class="dbr">
            <button class="btn btn-secondary" @onclick="CloseReqDialog">Cancel</button>
            <button class="btn btn-danger"    @onclick="ForceConfirm">Save Anyway</button>
        </div>
    </div>
</div>

<!-- Context menu -->
<div id="ctx-menu" class="ctx-menu" @onmousedown:stopPropagation>
    <div class="ctx-header">
        <span>Field Information</span>
        <button class="ctx-close" @onclick="CloseCtxMenu">✕</button>
    </div>
    <div class="ctx-body">
        <div class="ctx-row">
            <label>Current name:</label>
            <span>@CtxFieldName</span>
        </div>
        <div class="ctx-row">
            <label>Original name:</label>
            <span>@CtxOriginalName</span>
        </div>
        <hr class="ctx-divider" />
        <div class="ctx-guidance">
            <strong>Guidance:</strong><br />
            @CtxGuidance
        </div>
    </div>
</div>

<div class="sbar">
    <span>Section 2 – Introduction &nbsp;|&nbsp; Hover a field to see its ID</span>
    <span>@StatusMessage</span>
</div>

@code {
    private Section02Model Model = new();

    // ── Context menu ──────────────────────────────────────────────
    private bool   CtxOpen         = false;
    private string CtxFieldName    = string.Empty;
    private string CtxOriginalName = string.Empty;
    private string CtxGuidance     = string.Empty;



    // ── Context menu — called from JS via DotNetObjectReference ────
    [JSInvokable]
    public async Task OnContextMenuJS(string code, double x, double y)
    {
        var info = GetFieldInfo(code);
        CtxFieldName    = code;
        CtxOriginalName = info.originalName;
        CtxGuidance     = info.guidance;
        StateHasChanged();
        await JS.InvokeVoidAsync("udpShowCtxMenu", x, y);
    }

    [JSInvokable]
    public void OnCtxMenuClosed() => CtxOpen = false;

    private void CloseCtxMenu()
    {
        CtxOpen = false;
        _ = JS.InvokeVoidAsync("udpHideCtxMenu");
    }

    private (string originalName, string guidance) GetFieldInfo(string code) => code switch
    {
        "C146997" => ("PurposeOfTrial",       "guidance text goes here"),
        "C218721" => ("RiskTrialIntervention","guidance text goes here"),
        "C218722" => ("RiskTrialProcedures",  "guidance text goes here"),
        "C218723" => ("RiskOther",            "guidance text goes here"),
        "C218724" => ("BenefitSummary",       "guidance text goes here"),
        "C218725" => ("OverallRiskBenefit",   "guidance text goes here"),
        _         => (code,                   "guidance text goes here")
    };

    private bool   ShowValidation  = false;
    private bool   ShowSaveDialog  = false;
    private bool   ShowReqDialog   = false;
    private string SaveFileName    = "section2_data";
    private string SaveFormat      = "fhir";
    private string StatusMessage   = string.Empty;
    private string ReqDialogMessage = string.Empty;
    private string ErrorMessage    = string.Empty;
    private string? PendingAction  = null;

    private System.Threading.Timer?        _statusTimer;
    private DotNetObjectReference<Section02>? _objRef;

    // ── CSS helpers ───────────────────────────────────────────────
    private string SaveDialogCss => ShowSaveDialog ? "show" : string.Empty;
    private string ReqDialogCss  => ShowReqDialog  ? "show" : string.Empty;
    private string C146997Class  => ShowValidation && string.IsNullOrWhiteSpace(Model.C146997)
                                    ? "fb req-empty" : "fb";

    // ── Radio helpers ─────────────────────────────────────────────
    private bool IsJson => SaveFormat == "json";
    private bool IsCsv  => SaveFormat == "csv";
    private bool IsTxt  => SaveFormat == "txt";
    private bool IsFhir => SaveFormat == "fhir";
    private void SetFormatJson(ChangeEventArgs e) => SaveFormat = "json";
    private void SetFormatCsv(ChangeEventArgs e)  => SaveFormat = "csv";
    private void SetFormatTxt(ChangeEventArgs e)  => SaveFormat = "txt";
    private void SetFormatFhir(ChangeEventArgs e) => SaveFormat = "fhir";

    // ── Validation ────────────────────────────────────────────────
    private bool HasRequiredEmpty() => string.IsNullOrWhiteSpace(Model.C146997);

    // ── Clear ─────────────────────────────────────────────────────
    private void ClearAll()
    {
        Model          = new Section02Model();
        ShowValidation = false;
        ErrorMessage   = string.Empty;
        SetStatus("Cleared");
    }

    // ── Load Sample ───────────────────────────────────────────────
    private void LoadSample()
    {
        var sample = DataSvc.LoadSample();
        if (sample != null)
        {
            Model          = sample;
            ShowValidation = false;
            SetStatus("Sample data loaded");
        }
        else
        {
            ErrorMessage = "Could not load sample file.";
        }
    }

    // ── Save to Browser ───────────────────────────────────────────
    private async Task SaveToBrowser()
    {
        try
        {
            ShowValidation = true;
            if (HasRequiredEmpty())
            {
                ReqDialogMessage = "1 required field (C146997) is empty. Do you still want to save?";
                PendingAction    = "browser";
                ShowReqDialog    = true;
                return;
            }
            await DoBrowserSave();
        }
        catch (Exception ex) { ErrorMessage = "SaveToBrowser error: " + ex.Message; }
    }

    private async Task DoBrowserSave()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "s2data", DataSvc.ToJson(Model));
            SetStatus("✓ Saved " + DateTime.Now.ToShortTimeString());
        }
        catch (Exception ex) { ErrorMessage = "DoBrowserSave error: " + ex.Message; }
    }

    // ── Open Save Dialog ──────────────────────────────────────────
    private void OpenSaveDialog()
    {
        ShowValidation = true;
        if (HasRequiredEmpty())
        {
            ReqDialogMessage = "1 required field (C146997) is empty. Do you still want to save?";
            PendingAction    = "file";
            ShowReqDialog    = true;
            return;
        }
        SaveFileName   = "section2_data_" + DateTime.Now.ToString("yyyy-MM-dd");
        ShowSaveDialog = true;
    }

    private void CloseSaveDialog() => ShowSaveDialog = false;
    private void CloseReqDialog()  { ShowReqDialog = false; PendingAction = null; }

    // ── Force save ────────────────────────────────────────────────
    private async Task ForceConfirm()
    {
        ShowReqDialog = false;
        if (PendingAction == "browser")
            await DoBrowserSave();
        else if (PendingAction == "file")
        {
            SaveFileName   = "section2_data_" + DateTime.Now.ToString("yyyy-MM-dd");
            ShowSaveDialog = true;
        }
        PendingAction = null;
    }

    // ── Download file ─────────────────────────────────────────────
    private async Task DoSaveToFile()
    {
        try
        {
            ShowSaveDialog = false;
            var (content, mime, ext) = SaveFormat switch
            {
                "csv"  => (DataSvc.ToCsv(Model),      "text/csv",         ".csv"),
                "txt"  => (DataSvc.ToPlainText(Model), "text/plain",       ".txt"),
                "fhir" => (DataSvc.ToFsh(Model), "text/fsh",       ".fsh"),
                _      => (DataSvc.ToJson(Model),      "application/json", ".json"),
            };
            var fn = (SaveFileName.Trim().Length > 0 ? SaveFileName.Trim() : "section2_data") + ext;
            await JS.InvokeVoidAsync("udpDownload", fn, content, mime);
            SetStatus("⬇ Downloaded " + fn);
        }
        catch (Exception ex) { ErrorMessage = "DoSaveToFile error: " + ex.Message; }
    }

    // ── Load from file ────────────────────────────────────────────
    private async Task OpenLoadDialog()
    {
        try { await JS.InvokeVoidAsync("udpOpenFilePicker"); }
        catch (Exception ex) { ErrorMessage = "OpenLoadDialog error: " + ex.Message; }
    }

    [JSInvokable]
    public void ReceiveFileContent(string json)
    {
        var loaded = DataSvc.FromJson(json);
        if (loaded != null)
        {
            Model          = loaded;
            ShowValidation = false;
            SetStatus("⬆ Loaded from file");
            InvokeAsync(StateHasChanged);
        }
    }

    // ── Init ──────────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("udpSetDotNetRef", _objRef);
            await JS.InvokeVoidAsync("udpInitContextMenus");
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "s2data");
            if (!string.IsNullOrEmpty(json))
            {
                var loaded = DataSvc.FromJson(json);
                if (loaded != null) { Model = loaded; StateHasChanged(); }
            }
        }
        catch (Exception ex) { ErrorMessage = "Init error: " + ex.Message; StateHasChanged(); }
    }

    // ── Status ────────────────────────────────────────────────────
    private void SetStatus(string msg)
    {
        StatusMessage = msg;
        _statusTimer?.Dispose();
        _statusTimer = new System.Threading.Timer(_ =>
        {
            StatusMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        }, null, 4000, System.Threading.Timeout.Infinite);
    }

    public void Dispose() { _objRef?.Dispose(); _statusTimer?.Dispose(); }
}
